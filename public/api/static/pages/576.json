[{"sura_number":74,"ayah_number":18,"uthmani_text":"إِنَّهُ فَكَّرَ وَقَدَّرَ","simple_text":"إنه فكر وقدر"},{"sura_number":74,"ayah_number":19,"uthmani_text":"فَقُتِلَ كَيفَ قَدَّرَ","simple_text":"فقتل كيف قدر"},{"sura_number":74,"ayah_number":20,"uthmani_text":"ثُمَّ قُتِلَ كَيفَ قَدَّرَ","simple_text":"ثم قتل كيف قدر"},{"sura_number":74,"ayah_number":21,"uthmani_text":"ثُمَّ نَظَرَ","simple_text":"ثم نظر"},{"sura_number":74,"ayah_number":22,"uthmani_text":"ثُمَّ عَبَسَ وَبَسَرَ","simple_text":"ثم عبس وبسر"},{"sura_number":74,"ayah_number":23,"uthmani_text":"ثُمَّ أَدبَرَ وَاستَكبَرَ","simple_text":"ثم أدبر واستكبر"},{"sura_number":74,"ayah_number":24,"uthmani_text":"فَقالَ إِن هـٰذا إِلّا سِحرٌ يُؤثَرُ","simple_text":"فقال إن هذا إلا سحر يؤثر"},{"sura_number":74,"ayah_number":25,"uthmani_text":"إِن هـٰذا إِلّا قَولُ البَشَرِ","simple_text":"إن هذا إلا قول البشر"},{"sura_number":74,"ayah_number":26,"uthmani_text":"سَأُصليهِ سَقَرَ","simple_text":"سأصليه سقر"},{"sura_number":74,"ayah_number":27,"uthmani_text":"وَما أَدرىٰكَ ما سَقَرُ","simple_text":"وما أدراك ما سقر"},{"sura_number":74,"ayah_number":28,"uthmani_text":"لا تُبقى وَلا تَذَرُ","simple_text":"لا تبقي ولا تذر"},{"sura_number":74,"ayah_number":29,"uthmani_text":"لَوّاحَةٌ لِلبَشَرِ","simple_text":"لواحة للبشر"},{"sura_number":74,"ayah_number":30,"uthmani_text":"عَلَيها تِسعَةَ عَشَرَ","simple_text":"عليها تسعة عشر"},{"sura_number":74,"ayah_number":31,"uthmani_text":"وَما جَعَلنا أَصحـٰبَ النّارِ إِلّا مَلـٰئِكَةً ۙ وَما جَعَلنا عِدَّتَهُم إِلّا فِتنَةً لِلَّذينَ كَفَروا لِيَستَيقِنَ الَّذينَ أوتُوا الكِتـٰبَ وَيَزدادَ الَّذينَ ءامَنوا إيمـٰنًا ۙ وَلا يَرتابَ الَّذينَ أوتُوا الكِتـٰبَ وَالمُؤمِنونَ ۙ وَلِيَقولَ الَّذينَ فى قُلوبِهِم مَرَضٌ وَالكـٰفِرونَ ماذا أَرادَ اللَّهُ بِهـٰذا مَثَلًا ۚ كَذٰلِكَ يُضِلُّ اللَّهُ مَن يَشاءُ وَيَهدى مَن يَشاءُ ۚ وَما يَعلَمُ جُنودَ رَبِّكَ إِلّا هُوَ ۚ وَما هِىَ إِلّا ذِكرىٰ لِلبَشَرِ","simple_text":"وما جعلنا أصحاب النار إلا ملائكة ۙ وما جعلنا عدتهم إلا فتنة للذين كفروا ليستيقن الذين أوتوا الكتاب ويزداد الذين آمنوا إيمانا ۙ ولا يرتاب الذين أوتوا الكتاب والمؤمنون ۙ وليقول الذين في قلوبهم مرض والكافرون ماذا أراد الله بهذا مثلا ۚ كذلك يضل الله من يشاء ويهدي من يشاء ۚ وما يعلم جنود ربك إلا هو ۚ وما هي إلا ذكرى للبشر"},{"sura_number":74,"ayah_number":32,"uthmani_text":"كَلّا وَالقَمَرِ","simple_text":"كلا والقمر"},{"sura_number":74,"ayah_number":33,"uthmani_text":"وَالَّيلِ إِذ أَدبَرَ","simple_text":"والليل إذ أدبر"},{"sura_number":74,"ayah_number":34,"uthmani_text":"وَالصُّبحِ إِذا أَسفَرَ","simple_text":"والصبح إذا أسفر"},{"sura_number":74,"ayah_number":35,"uthmani_text":"إِنَّها لَإِحدَى الكُبَرِ","simple_text":"إنها لإحدى الكبر"},{"sura_number":74,"ayah_number":36,"uthmani_text":"نَذيرًا لِلبَشَرِ","simple_text":"نذيرا للبشر"},{"sura_number":74,"ayah_number":37,"uthmani_text":"لِمَن شاءَ مِنكُم أَن يَتَقَدَّمَ أَو يَتَأَخَّرَ","simple_text":"لمن شاء منكم أن يتقدم أو يتأخر"},{"sura_number":74,"ayah_number":38,"uthmani_text":"كُلُّ نَفسٍ بِما كَسَبَت رَهينَةٌ","simple_text":"كل نفس بما كسبت رهينة"},{"sura_number":74,"ayah_number":39,"uthmani_text":"إِلّا أَصحـٰبَ اليَمينِ","simple_text":"إلا أصحاب اليمين"},{"sura_number":74,"ayah_number":40,"uthmani_text":"فى جَنّـٰتٍ يَتَساءَلونَ","simple_text":"في جنات يتساءلون"},{"sura_number":74,"ayah_number":41,"uthmani_text":"عَنِ المُجرِمينَ","simple_text":"عن المجرمين"},{"sura_number":74,"ayah_number":42,"uthmani_text":"ما سَلَكَكُم فى سَقَرَ","simple_text":"ما سلككم في سقر"},{"sura_number":74,"ayah_number":43,"uthmani_text":"قالوا لَم نَكُ مِنَ المُصَلّينَ","simple_text":"قالوا لم نك من المصلين"},{"sura_number":74,"ayah_number":44,"uthmani_text":"وَلَم نَكُ نُطعِمُ المِسكينَ","simple_text":"ولم نك نطعم المسكين"},{"sura_number":74,"ayah_number":45,"uthmani_text":"وَكُنّا نَخوضُ مَعَ الخائِضينَ","simple_text":"وكنا نخوض مع الخائضين"},{"sura_number":74,"ayah_number":46,"uthmani_text":"وَكُنّا نُكَذِّبُ بِيَومِ الدّينِ","simple_text":"وكنا نكذب بيوم الدين"},{"sura_number":74,"ayah_number":47,"uthmani_text":"حَتّىٰ أَتىٰنَا اليَقينُ","simple_text":"حتى أتانا اليقين"}]