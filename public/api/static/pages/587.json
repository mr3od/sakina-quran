[{"sura_number":82,"ayah_number":1,"uthmani_text":"إِذَا السَّماءُ انفَطَرَت","simple_text":"إذا السماء انفطرت"},{"sura_number":82,"ayah_number":2,"uthmani_text":"وَإِذَا الكَواكِبُ انتَثَرَت","simple_text":"وإذا الكواكب انتثرت"},{"sura_number":82,"ayah_number":3,"uthmani_text":"وَإِذَا البِحارُ فُجِّرَت","simple_text":"وإذا البحار فجرت"},{"sura_number":82,"ayah_number":4,"uthmani_text":"وَإِذَا القُبورُ بُعثِرَت","simple_text":"وإذا القبور بعثرت"},{"sura_number":82,"ayah_number":5,"uthmani_text":"عَلِمَت نَفسٌ ما قَدَّمَت وَأَخَّرَت","simple_text":"علمت نفس ما قدمت وأخرت"},{"sura_number":82,"ayah_number":6,"uthmani_text":"يـٰأَيُّهَا الإِنسـٰنُ ما غَرَّكَ بِرَبِّكَ الكَريمِ","simple_text":"يا أيها الإنسان ما غرك بربك الكريم"},{"sura_number":82,"ayah_number":7,"uthmani_text":"الَّذى خَلَقَكَ فَسَوّىٰكَ فَعَدَلَكَ","simple_text":"الذي خلقك فسواك فعدلك"},{"sura_number":82,"ayah_number":8,"uthmani_text":"فى أَىِّ صورَةٍ ما شاءَ رَكَّبَكَ","simple_text":"في أي صورة ما شاء ركبك"},{"sura_number":82,"ayah_number":9,"uthmani_text":"كَلّا بَل تُكَذِّبونَ بِالدّينِ","simple_text":"كلا بل تكذبون بالدين"},{"sura_number":82,"ayah_number":10,"uthmani_text":"وَإِنَّ عَلَيكُم لَحـٰفِظينَ","simple_text":"وإن عليكم لحافظين"},{"sura_number":82,"ayah_number":11,"uthmani_text":"كِرامًا كـٰتِبينَ","simple_text":"كراما كاتبين"},{"sura_number":82,"ayah_number":12,"uthmani_text":"يَعلَمونَ ما تَفعَلونَ","simple_text":"يعلمون ما تفعلون"},{"sura_number":82,"ayah_number":13,"uthmani_text":"إِنَّ الأَبرارَ لَفى نَعيمٍ","simple_text":"إن الأبرار لفي نعيم"},{"sura_number":82,"ayah_number":14,"uthmani_text":"وَإِنَّ الفُجّارَ لَفى جَحيمٍ","simple_text":"وإن الفجار لفي جحيم"},{"sura_number":82,"ayah_number":15,"uthmani_text":"يَصلَونَها يَومَ الدّينِ","simple_text":"يصلونها يوم الدين"},{"sura_number":82,"ayah_number":16,"uthmani_text":"وَما هُم عَنها بِغائِبينَ","simple_text":"وما هم عنها بغائبين"},{"sura_number":82,"ayah_number":17,"uthmani_text":"وَما أَدرىٰكَ ما يَومُ الدّينِ","simple_text":"وما أدراك ما يوم الدين"},{"sura_number":82,"ayah_number":18,"uthmani_text":"ثُمَّ ما أَدرىٰكَ ما يَومُ الدّينِ","simple_text":"ثم ما أدراك ما يوم الدين"},{"sura_number":82,"ayah_number":19,"uthmani_text":"يَومَ لا تَملِكُ نَفسٌ لِنَفسٍ شَيـًٔا ۖ وَالأَمرُ يَومَئِذٍ لِلَّهِ","simple_text":"يوم لا تملك نفس لنفس شيئا ۖ والأمر يومئذ لله"},{"sura_number":83,"ayah_number":1,"uthmani_text":"وَيلٌ لِلمُطَفِّفينَ","simple_text":"ويل للمطففين"},{"sura_number":83,"ayah_number":2,"uthmani_text":"الَّذينَ إِذَا اكتالوا عَلَى النّاسِ يَستَوفونَ","simple_text":"الذين إذا اكتالوا على الناس يستوفون"},{"sura_number":83,"ayah_number":3,"uthmani_text":"وَإِذا كالوهُم أَو وَزَنوهُم يُخسِرونَ","simple_text":"وإذا كالوهم أو وزنوهم يخسرون"},{"sura_number":83,"ayah_number":4,"uthmani_text":"أَلا يَظُنُّ أُولـٰئِكَ أَنَّهُم مَبعوثونَ","simple_text":"ألا يظن أولئك أنهم مبعوثون"},{"sura_number":83,"ayah_number":5,"uthmani_text":"لِيَومٍ عَظيمٍ","simple_text":"ليوم عظيم"},{"sura_number":83,"ayah_number":6,"uthmani_text":"يَومَ يَقومُ النّاسُ لِرَبِّ العـٰلَمينَ","simple_text":"يوم يقوم الناس لرب العالمين"}]