[{"sura_number":55,"ayah_number":17,"uthmani_text":"رَبُّ المَشرِقَينِ وَرَبُّ المَغرِبَينِ","simple_text":"رب المشرقين ورب المغربين"},{"sura_number":55,"ayah_number":18,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":19,"uthmani_text":"مَرَجَ البَحرَينِ يَلتَقِيانِ","simple_text":"مرج البحرين يلتقيان"},{"sura_number":55,"ayah_number":20,"uthmani_text":"بَينَهُما بَرزَخٌ لا يَبغِيانِ","simple_text":"بينهما برزخ لا يبغيان"},{"sura_number":55,"ayah_number":21,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":22,"uthmani_text":"يَخرُجُ مِنهُمَا اللُّؤلُؤُ وَالمَرجانُ","simple_text":"يخرج منهما اللؤلؤ والمرجان"},{"sura_number":55,"ayah_number":23,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":24,"uthmani_text":"وَلَهُ الجَوارِ المُنشَـٔاتُ فِى البَحرِ كَالأَعلـٰمِ","simple_text":"وله الجوار المنشآت في البحر كالأعلام"},{"sura_number":55,"ayah_number":25,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":26,"uthmani_text":"كُلُّ مَن عَلَيها فانٍ","simple_text":"كل من عليها فان"},{"sura_number":55,"ayah_number":27,"uthmani_text":"وَيَبقىٰ وَجهُ رَبِّكَ ذُو الجَلـٰلِ وَالإِكرامِ","simple_text":"ويبقى وجه ربك ذو الجلال والإكرام"},{"sura_number":55,"ayah_number":28,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":29,"uthmani_text":"يَسـَٔلُهُ مَن فِى السَّمـٰوٰتِ وَالأَرضِ ۚ كُلَّ يَومٍ هُوَ فى شَأنٍ","simple_text":"يسأله من في السماوات والأرض ۚ كل يوم هو في شأن"},{"sura_number":55,"ayah_number":30,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":31,"uthmani_text":"سَنَفرُغُ لَكُم أَيُّهَ الثَّقَلانِ","simple_text":"سنفرغ لكم أيه الثقلان"},{"sura_number":55,"ayah_number":32,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":33,"uthmani_text":"يـٰمَعشَرَ الجِنِّ وَالإِنسِ إِنِ استَطَعتُم أَن تَنفُذوا مِن أَقطارِ السَّمـٰوٰتِ وَالأَرضِ فَانفُذوا ۚ لا تَنفُذونَ إِلّا بِسُلطـٰنٍ","simple_text":"يا معشر الجن والإنس إن استطعتم أن تنفذوا من أقطار السماوات والأرض فانفذوا ۚ لا تنفذون إلا بسلطان"},{"sura_number":55,"ayah_number":34,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":35,"uthmani_text":"يُرسَلُ عَلَيكُما شُواظٌ مِن نارٍ وَنُحاسٌ فَلا تَنتَصِرانِ","simple_text":"يرسل عليكما شواظ من نار ونحاس فلا تنتصران"},{"sura_number":55,"ayah_number":36,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":37,"uthmani_text":"فَإِذَا انشَقَّتِ السَّماءُ فَكانَت وَردَةً كَالدِّهانِ","simple_text":"فإذا انشقت السماء فكانت وردة كالدهان"},{"sura_number":55,"ayah_number":38,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":39,"uthmani_text":"فَيَومَئِذٍ لا يُسـَٔلُ عَن ذَنبِهِ إِنسٌ وَلا جانٌّ","simple_text":"فيومئذ لا يسأل عن ذنبه إنس ولا جان"},{"sura_number":55,"ayah_number":40,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"}]