[{"sura_number":91,"ayah_number":1,"uthmani_text":"وَالشَّمسِ وَضُحىٰها","simple_text":"والشمس وضحاها"},{"sura_number":91,"ayah_number":2,"uthmani_text":"وَالقَمَرِ إِذا تَلىٰها","simple_text":"والقمر إذا تلاها"},{"sura_number":91,"ayah_number":3,"uthmani_text":"وَالنَّهارِ إِذا جَلّىٰها","simple_text":"والنهار إذا جلاها"},{"sura_number":91,"ayah_number":4,"uthmani_text":"وَالَّيلِ إِذا يَغشىٰها","simple_text":"والليل إذا يغشاها"},{"sura_number":91,"ayah_number":5,"uthmani_text":"وَالسَّماءِ وَما بَنىٰها","simple_text":"والسماء وما بناها"},{"sura_number":91,"ayah_number":6,"uthmani_text":"وَالأَرضِ وَما طَحىٰها","simple_text":"والأرض وما طحاها"},{"sura_number":91,"ayah_number":7,"uthmani_text":"وَنَفسٍ وَما سَوّىٰها","simple_text":"ونفس وما سواها"},{"sura_number":91,"ayah_number":8,"uthmani_text":"فَأَلهَمَها فُجورَها وَتَقوىٰها","simple_text":"فألهمها فجورها وتقواها"},{"sura_number":91,"ayah_number":9,"uthmani_text":"قَد أَفلَحَ مَن زَكّىٰها","simple_text":"قد أفلح من زكاها"},{"sura_number":91,"ayah_number":10,"uthmani_text":"وَقَد خابَ مَن دَسّىٰها","simple_text":"وقد خاب من دساها"},{"sura_number":91,"ayah_number":11,"uthmani_text":"كَذَّبَت ثَمودُ بِطَغوىٰها","simple_text":"كذبت ثمود بطغواها"},{"sura_number":91,"ayah_number":12,"uthmani_text":"إِذِ انبَعَثَ أَشقىٰها","simple_text":"إذ انبعث أشقاها"},{"sura_number":91,"ayah_number":13,"uthmani_text":"فَقالَ لَهُم رَسولُ اللَّهِ ناقَةَ اللَّهِ وَسُقيـٰها","simple_text":"فقال لهم رسول الله ناقة الله وسقياها"},{"sura_number":91,"ayah_number":14,"uthmani_text":"فَكَذَّبوهُ فَعَقَروها فَدَمدَمَ عَلَيهِم رَبُّهُم بِذَنبِهِم فَسَوّىٰها","simple_text":"فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها"},{"sura_number":91,"ayah_number":15,"uthmani_text":"وَلا يَخافُ عُقبـٰها","simple_text":"ولا يخاف عقباها"},{"sura_number":92,"ayah_number":1,"uthmani_text":"وَالَّيلِ إِذا يَغشىٰ","simple_text":"والليل إذا يغشى"},{"sura_number":92,"ayah_number":2,"uthmani_text":"وَالنَّهارِ إِذا تَجَلّىٰ","simple_text":"والنهار إذا تجلى"},{"sura_number":92,"ayah_number":3,"uthmani_text":"وَما خَلَقَ الذَّكَرَ وَالأُنثىٰ","simple_text":"وما خلق الذكر والأنثى"},{"sura_number":92,"ayah_number":4,"uthmani_text":"إِنَّ سَعيَكُم لَشَتّىٰ","simple_text":"إن سعيكم لشتى"},{"sura_number":92,"ayah_number":5,"uthmani_text":"فَأَمّا مَن أَعطىٰ وَاتَّقىٰ","simple_text":"فأما من أعطى واتقى"},{"sura_number":92,"ayah_number":6,"uthmani_text":"وَصَدَّقَ بِالحُسنىٰ","simple_text":"وصدق بالحسنى"},{"sura_number":92,"ayah_number":7,"uthmani_text":"فَسَنُيَسِّرُهُ لِليُسرىٰ","simple_text":"فسنيسره لليسرى"},{"sura_number":92,"ayah_number":8,"uthmani_text":"وَأَمّا مَن بَخِلَ وَاستَغنىٰ","simple_text":"وأما من بخل واستغنى"},{"sura_number":92,"ayah_number":9,"uthmani_text":"وَكَذَّبَ بِالحُسنىٰ","simple_text":"وكذب بالحسنى"},{"sura_number":92,"ayah_number":10,"uthmani_text":"فَسَنُيَسِّرُهُ لِلعُسرىٰ","simple_text":"فسنيسره للعسرى"},{"sura_number":92,"ayah_number":11,"uthmani_text":"وَما يُغنى عَنهُ مالُهُ إِذا تَرَدّىٰ","simple_text":"وما يغني عنه ماله إذا تردى"},{"sura_number":92,"ayah_number":12,"uthmani_text":"إِنَّ عَلَينا لَلهُدىٰ","simple_text":"إن علينا للهدى"},{"sura_number":92,"ayah_number":13,"uthmani_text":"وَإِنَّ لَنا لَلـٔاخِرَةَ وَالأولىٰ","simple_text":"وإن لنا للآخرة والأولى"},{"sura_number":92,"ayah_number":14,"uthmani_text":"فَأَنذَرتُكُم نارًا تَلَظّىٰ","simple_text":"فأنذرتكم نارا تلظى"}]