[{"sura_number":86,"ayah_number":1,"uthmani_text":"وَالسَّماءِ وَالطّارِقِ","simple_text":"والسماء والطارق"},{"sura_number":86,"ayah_number":2,"uthmani_text":"وَما أَدرىٰكَ مَا الطّارِقُ","simple_text":"وما أدراك ما الطارق"},{"sura_number":86,"ayah_number":3,"uthmani_text":"النَّجمُ الثّاقِبُ","simple_text":"النجم الثاقب"},{"sura_number":86,"ayah_number":4,"uthmani_text":"إِن كُلُّ نَفسٍ لَمّا عَلَيها حافِظٌ","simple_text":"إن كل نفس لما عليها حافظ"},{"sura_number":86,"ayah_number":5,"uthmani_text":"فَليَنظُرِ الإِنسـٰنُ مِمَّ خُلِقَ","simple_text":"فلينظر الإنسان مم خلق"},{"sura_number":86,"ayah_number":6,"uthmani_text":"خُلِقَ مِن ماءٍ دافِقٍ","simple_text":"خلق من ماء دافق"},{"sura_number":86,"ayah_number":7,"uthmani_text":"يَخرُجُ مِن بَينِ الصُّلبِ وَالتَّرائِبِ","simple_text":"يخرج من بين الصلب والترائب"},{"sura_number":86,"ayah_number":8,"uthmani_text":"إِنَّهُ عَلىٰ رَجعِهِ لَقادِرٌ","simple_text":"إنه على رجعه لقادر"},{"sura_number":86,"ayah_number":9,"uthmani_text":"يَومَ تُبلَى السَّرائِرُ","simple_text":"يوم تبلى السرائر"},{"sura_number":86,"ayah_number":10,"uthmani_text":"فَما لَهُ مِن قُوَّةٍ وَلا ناصِرٍ","simple_text":"فما له من قوة ولا ناصر"},{"sura_number":86,"ayah_number":11,"uthmani_text":"وَالسَّماءِ ذاتِ الرَّجعِ","simple_text":"والسماء ذات الرجع"},{"sura_number":86,"ayah_number":12,"uthmani_text":"وَالأَرضِ ذاتِ الصَّدعِ","simple_text":"والأرض ذات الصدع"},{"sura_number":86,"ayah_number":13,"uthmani_text":"إِنَّهُ لَقَولٌ فَصلٌ","simple_text":"إنه لقول فصل"},{"sura_number":86,"ayah_number":14,"uthmani_text":"وَما هُوَ بِالهَزلِ","simple_text":"وما هو بالهزل"},{"sura_number":86,"ayah_number":15,"uthmani_text":"إِنَّهُم يَكيدونَ كَيدًا","simple_text":"إنهم يكيدون كيدا"},{"sura_number":86,"ayah_number":16,"uthmani_text":"وَأَكيدُ كَيدًا","simple_text":"وأكيد كيدا"},{"sura_number":86,"ayah_number":17,"uthmani_text":"فَمَهِّلِ الكـٰفِرينَ أَمهِلهُم رُوَيدًا","simple_text":"فمهل الكافرين أمهلهم رويدا"},{"sura_number":87,"ayah_number":1,"uthmani_text":"سَبِّحِ اسمَ رَبِّكَ الأَعلَى","simple_text":"سبح اسم ربك الأعلى"},{"sura_number":87,"ayah_number":2,"uthmani_text":"الَّذى خَلَقَ فَسَوّىٰ","simple_text":"الذي خلق فسوى"},{"sura_number":87,"ayah_number":3,"uthmani_text":"وَالَّذى قَدَّرَ فَهَدىٰ","simple_text":"والذي قدر فهدى"},{"sura_number":87,"ayah_number":4,"uthmani_text":"وَالَّذى أَخرَجَ المَرعىٰ","simple_text":"والذي أخرج المرعى"},{"sura_number":87,"ayah_number":5,"uthmani_text":"فَجَعَلَهُ غُثاءً أَحوىٰ","simple_text":"فجعله غثاء أحوى"},{"sura_number":87,"ayah_number":6,"uthmani_text":"سَنُقرِئُكَ فَلا تَنسىٰ","simple_text":"سنقرئك فلا تنسى"},{"sura_number":87,"ayah_number":7,"uthmani_text":"إِلّا ما شاءَ اللَّهُ ۚ إِنَّهُ يَعلَمُ الجَهرَ وَما يَخفىٰ","simple_text":"إلا ما شاء الله ۚ إنه يعلم الجهر وما يخفى"},{"sura_number":87,"ayah_number":8,"uthmani_text":"وَنُيَسِّرُكَ لِليُسرىٰ","simple_text":"ونيسرك لليسرى"},{"sura_number":87,"ayah_number":9,"uthmani_text":"فَذَكِّر إِن نَفَعَتِ الذِّكرىٰ","simple_text":"فذكر إن نفعت الذكرى"},{"sura_number":87,"ayah_number":10,"uthmani_text":"سَيَذَّكَّرُ مَن يَخشىٰ","simple_text":"سيذكر من يخشى"},{"sura_number":87,"ayah_number":11,"uthmani_text":"وَيَتَجَنَّبُهَا الأَشقَى","simple_text":"ويتجنبها الأشقى"},{"sura_number":87,"ayah_number":12,"uthmani_text":"الَّذى يَصلَى النّارَ الكُبرىٰ","simple_text":"الذي يصلى النار الكبرى"},{"sura_number":87,"ayah_number":13,"uthmani_text":"ثُمَّ لا يَموتُ فيها وَلا يَحيىٰ","simple_text":"ثم لا يموت فيها ولا يحيى"},{"sura_number":87,"ayah_number":14,"uthmani_text":"قَد أَفلَحَ مَن تَزَكّىٰ","simple_text":"قد أفلح من تزكى"},{"sura_number":87,"ayah_number":15,"uthmani_text":"وَذَكَرَ اسمَ رَبِّهِ فَصَلّىٰ","simple_text":"وذكر اسم ربه فصلى"}]