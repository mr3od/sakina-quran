[{"sura_number":26,"ayah_number":184,"uthmani_text":"وَاتَّقُوا الَّذى خَلَقَكُم وَالجِبِلَّةَ الأَوَّلينَ","simple_text":"واتقوا الذي خلقكم والجبلة الأولين"},{"sura_number":26,"ayah_number":185,"uthmani_text":"قالوا إِنَّما أَنتَ مِنَ المُسَحَّرينَ","simple_text":"قالوا إنما أنت من المسحرين"},{"sura_number":26,"ayah_number":186,"uthmani_text":"وَما أَنتَ إِلّا بَشَرٌ مِثلُنا وَإِن نَظُنُّكَ لَمِنَ الكـٰذِبينَ","simple_text":"وما أنت إلا بشر مثلنا وإن نظنك لمن الكاذبين"},{"sura_number":26,"ayah_number":187,"uthmani_text":"فَأَسقِط عَلَينا كِسَفًا مِنَ السَّماءِ إِن كُنتَ مِنَ الصّـٰدِقينَ","simple_text":"فأسقط علينا كسفا من السماء إن كنت من الصادقين"},{"sura_number":26,"ayah_number":188,"uthmani_text":"قالَ رَبّى أَعلَمُ بِما تَعمَلونَ","simple_text":"قال ربي أعلم بما تعملون"},{"sura_number":26,"ayah_number":189,"uthmani_text":"فَكَذَّبوهُ فَأَخَذَهُم عَذابُ يَومِ الظُّلَّةِ ۚ إِنَّهُ كانَ عَذابَ يَومٍ عَظيمٍ","simple_text":"فكذبوه فأخذهم عذاب يوم الظلة ۚ إنه كان عذاب يوم عظيم"},{"sura_number":26,"ayah_number":190,"uthmani_text":"إِنَّ فى ذٰلِكَ لَـٔايَةً ۖ وَما كانَ أَكثَرُهُم مُؤمِنينَ","simple_text":"إن في ذلك لآية ۖ وما كان أكثرهم مؤمنين"},{"sura_number":26,"ayah_number":191,"uthmani_text":"وَإِنَّ رَبَّكَ لَهُوَ العَزيزُ الرَّحيمُ","simple_text":"وإن ربك لهو العزيز الرحيم"},{"sura_number":26,"ayah_number":192,"uthmani_text":"وَإِنَّهُ لَتَنزيلُ رَبِّ العـٰلَمينَ","simple_text":"وإنه لتنزيل رب العالمين"},{"sura_number":26,"ayah_number":193,"uthmani_text":"نَزَلَ بِهِ الرّوحُ الأَمينُ","simple_text":"نزل به الروح الأمين"},{"sura_number":26,"ayah_number":194,"uthmani_text":"عَلىٰ قَلبِكَ لِتَكونَ مِنَ المُنذِرينَ","simple_text":"على قلبك لتكون من المنذرين"},{"sura_number":26,"ayah_number":195,"uthmani_text":"بِلِسانٍ عَرَبِىٍّ مُبينٍ","simple_text":"بلسان عربي مبين"},{"sura_number":26,"ayah_number":196,"uthmani_text":"وَإِنَّهُ لَفى زُبُرِ الأَوَّلينَ","simple_text":"وإنه لفي زبر الأولين"},{"sura_number":26,"ayah_number":197,"uthmani_text":"أَوَلَم يَكُن لَهُم ءايَةً أَن يَعلَمَهُ عُلَمـٰؤُا۟ بَنى إِسرٰءيلَ","simple_text":"أولم يكن لهم آية أن يعلمه علماء بني إسرائيل"},{"sura_number":26,"ayah_number":198,"uthmani_text":"وَلَو نَزَّلنـٰهُ عَلىٰ بَعضِ الأَعجَمينَ","simple_text":"ولو نزلناه على بعض الأعجمين"},{"sura_number":26,"ayah_number":199,"uthmani_text":"فَقَرَأَهُ عَلَيهِم ما كانوا بِهِ مُؤمِنينَ","simple_text":"فقرأه عليهم ما كانوا به مؤمنين"},{"sura_number":26,"ayah_number":200,"uthmani_text":"كَذٰلِكَ سَلَكنـٰهُ فى قُلوبِ المُجرِمينَ","simple_text":"كذلك سلكناه في قلوب المجرمين"},{"sura_number":26,"ayah_number":201,"uthmani_text":"لا يُؤمِنونَ بِهِ حَتّىٰ يَرَوُا العَذابَ الأَليمَ","simple_text":"لا يؤمنون به حتى يروا العذاب الأليم"},{"sura_number":26,"ayah_number":202,"uthmani_text":"فَيَأتِيَهُم بَغتَةً وَهُم لا يَشعُرونَ","simple_text":"فيأتيهم بغتة وهم لا يشعرون"},{"sura_number":26,"ayah_number":203,"uthmani_text":"فَيَقولوا هَل نَحنُ مُنظَرونَ","simple_text":"فيقولوا هل نحن منظرون"},{"sura_number":26,"ayah_number":204,"uthmani_text":"أَفَبِعَذابِنا يَستَعجِلونَ","simple_text":"أفبعذابنا يستعجلون"},{"sura_number":26,"ayah_number":205,"uthmani_text":"أَفَرَءَيتَ إِن مَتَّعنـٰهُم سِنينَ","simple_text":"أفرأيت إن متعناهم سنين"},{"sura_number":26,"ayah_number":206,"uthmani_text":"ثُمَّ جاءَهُم ما كانوا يوعَدونَ","simple_text":"ثم جاءهم ما كانوا يوعدون"}]