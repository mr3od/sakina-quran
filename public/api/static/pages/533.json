[{"sura_number":55,"ayah_number":41,"uthmani_text":"يُعرَفُ المُجرِمونَ بِسيمـٰهُم فَيُؤخَذُ بِالنَّوٰصى وَالأَقدامِ","simple_text":"يعرف المجرمون بسيماهم فيؤخذ بالنواصي والأقدام"},{"sura_number":55,"ayah_number":42,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":43,"uthmani_text":"هـٰذِهِ جَهَنَّمُ الَّتى يُكَذِّبُ بِهَا المُجرِمونَ","simple_text":"هذه جهنم التي يكذب بها المجرمون"},{"sura_number":55,"ayah_number":44,"uthmani_text":"يَطوفونَ بَينَها وَبَينَ حَميمٍ ءانٍ","simple_text":"يطوفون بينها وبين حميم آن"},{"sura_number":55,"ayah_number":45,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":46,"uthmani_text":"وَلِمَن خافَ مَقامَ رَبِّهِ جَنَّتانِ","simple_text":"ولمن خاف مقام ربه جنتان"},{"sura_number":55,"ayah_number":47,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":48,"uthmani_text":"ذَواتا أَفنانٍ","simple_text":"ذواتا أفنان"},{"sura_number":55,"ayah_number":49,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":50,"uthmani_text":"فيهِما عَينانِ تَجرِيانِ","simple_text":"فيهما عينان تجريان"},{"sura_number":55,"ayah_number":51,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":52,"uthmani_text":"فيهِما مِن كُلِّ فـٰكِهَةٍ زَوجانِ","simple_text":"فيهما من كل فاكهة زوجان"},{"sura_number":55,"ayah_number":53,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":54,"uthmani_text":"مُتَّكِـٔينَ عَلىٰ فُرُشٍ بَطائِنُها مِن إِستَبرَقٍ ۚ وَجَنَى الجَنَّتَينِ دانٍ","simple_text":"متكئين على فرش بطائنها من إستبرق ۚ وجنى الجنتين دان"},{"sura_number":55,"ayah_number":55,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما 