[{"sura_number":89,"ayah_number":1,"uthmani_text":"وَالفَجرِ","simple_text":"والفجر"},{"sura_number":89,"ayah_number":2,"uthmani_text":"وَلَيالٍ عَشرٍ","simple_text":"وليال عشر"},{"sura_number":89,"ayah_number":3,"uthmani_text":"وَالشَّفعِ وَالوَترِ","simple_text":"والشفع والوتر"},{"sura_number":89,"ayah_number":4,"uthmani_text":"وَالَّيلِ إِذا يَسرِ","simple_text":"والليل إذا يسر"},{"sura_number":89,"ayah_number":5,"uthmani_text":"هَل فى ذٰلِكَ قَسَمٌ لِذى حِجرٍ","simple_text":"هل في ذلك قسم لذي حجر"},{"sura_number":89,"ayah_number":6,"uthmani_text":"أَلَم تَرَ كَيفَ فَعَلَ رَبُّكَ بِعادٍ","simple_text":"ألم تر كيف فعل ربك بعاد"},{"sura_number":89,"ayah_number":7,"uthmani_text":"إِرَمَ ذاتِ العِمادِ","simple_text":"إرم ذات العماد"},{"sura_number":89,"ayah_number":8,"uthmani_text":"الَّتى لَم يُخلَق مِثلُها فِى البِلـٰدِ","simple_text":"التي لم يخلق مثلها في البلاد"},{"sura_number":89,"ayah_number":9,"uthmani_text":"وَثَمودَ الَّذينَ جابُوا الصَّخرَ بِالوادِ","simple_text":"وثمود الذين جابوا الصخر بالواد"},{"sura_number":89,"ayah_number":10,"uthmani_text":"وَفِرعَونَ ذِى الأَوتادِ","simple_text":"وفرعون ذي الأوتاد"},{"sura_number":89,"ayah_number":11,"uthmani_text":"الَّذينَ طَغَوا فِى البِلـٰدِ","simple_text":"الذين طغوا في البلاد"},{"sura_number":89,"ayah_number":12,"uthmani_text":"فَأَكثَروا فيهَا الفَسادَ","simple_text":"فأكثروا فيها الفساد"},{"sura_number":89,"ayah_number":13,"uthmani_text":"فَصَبَّ عَلَيهِم رَبُّكَ سَوطَ عَذابٍ","simple_text":"فصب عليهم ربك سوط عذاب"},{"sura_number":89,"ayah_number":14,"uthmani_text":"إِنَّ رَبَّكَ لَبِالمِرصادِ","simple_text":"إن ربك لبالمرصاد"},{"sura_number":89,"ayah_number":15,"uthmani_text":"فَأَمَّا الإِنسـٰنُ إِذا مَا ابتَلىٰهُ رَبُّهُ فَأَكرَمَهُ وَنَعَّمَهُ فَيَقولُ رَبّى أَكرَمَنِ","simple_text":"فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن"},{"sura_number":89,"ayah_number":16,"uthmani_text":"وَأَمّا إِذا مَا ابتَلىٰهُ فَقَدَرَ عَلَيهِ رِزقَهُ فَيَقولُ رَبّى أَهـٰنَنِ","simple_text":"وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن"},{"sura_number":89,"ayah_number":17,"uthmani_text":"كَلّا ۖ بَل لا تُكرِمونَ اليَتيمَ","simple_text":"كلا ۖ بل لا تكرمون اليتيم"},{"sura_number":89,"ayah_number":18,"uthmani_text":"وَلا تَحـٰضّونَ عَلىٰ طَعامِ المِسكينِ","simple_text":"ولا تحاضون على طعام المسكين"},{"sura_number":89,"ayah_number":19,"uthmani_text":"وَتَأكُلونَ التُّراثَ أَكلًا لَمًّا","simple_text":"وتأكلون التراث أكلا لما"},{"sura_number":89,"ayah_number":20,"uthmani_text":"وَتُحِبّونَ المالَ حُبًّا جَمًّا","simple_text":"وتحبون المال حبا جما"},{"sura_number":89,"ayah_number":21,"uthmani_text":"كَلّا إِذا دُكَّتِ الأَرضُ دَكًّا دَكًّا","simple_text":"كلا إذا دكت الأرض دكا دكا"},{"sura_number":89,"ayah_number":22,"uthmani_text":"وَجاءَ رَبُّكَ وَالمَلَكُ صَفًّا صَفًّا","simple_text":"وجاء ربك والملك صفا صفا"},{"sura_number":89,"ayah_number":23,"uthmani_text":"وَجِا۟ىءَ يَومَئِذٍ بِجَهَنَّمَ ۚ يَومَئِذٍ يَتَذَكَّرُ الإِنسـٰنُ وَأَنّىٰ لَهُ الذِّكرىٰ","simple_text":"وجيء يومئذ بجهنم ۚ يومئذ يتذكر الإنسان وأنى له الذكرى"}]