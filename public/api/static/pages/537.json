[{"sura_number":56,"ayah_number":77,"uthmani_text":"إِنَّهُ لَقُرءانٌ كَريمٌ","simple_text":"إنه لقرآن كريم"},{"sura_number":56,"ayah_number":78,"uthmani_text":"فى كِتـٰبٍ مَكنونٍ","simple_text":"في كتاب مكنون"},{"sura_number":56,"ayah_number":79,"uthmani_text":"لا يَمَسُّهُ إِلَّا المُطَهَّرونَ","simple_text":"لا يمسه إلا المطهرون"},{"sura_number":56,"ayah_number":80,"uthmani_text":"تَنزيلٌ مِن رَبِّ العـٰلَمينَ","simple_text":"تنزيل من رب العالمين"},{"sura_number":56,"ayah_number":81,"uthmani_text":"أَفَبِهـٰذَا الحَديثِ أَنتُم مُدهِنونَ","simple_text":"أفبهذا الحديث أنتم مدهنون"},{"sura_number":56,"ayah_number":82,"uthmani_text":"وَتَجعَلونَ رِزقَكُم أَنَّكُم تُكَذِّبونَ","simple_text":"وتجعلون رزقكم أنكم تكذبون"},{"sura_number":56,"ayah_number":83,"uthmani_text":"فَلَولا إِذا بَلَغَتِ الحُلقومَ","simple_text":"فلولا إذا بلغت الحلقوم"},{"sura_number":56,"ayah_number":84,"uthmani_text":"وَأَنتُم حينَئِذٍ تَنظُرونَ","simple_text":"وأنتم حينئذ تنظرون"},{"sura_number":56,"ayah_number":85,"uthmani_text":"وَنَحنُ أَقرَبُ إِلَيهِ مِنكُم وَلـٰكِن لا تُبصِرونَ","simple_text":"ونحن أقرب إليه منكم ولكن لا تبصرون"},{"sura_number":56,"ayah_number":86,"uthmani_text":"فَلَولا إِن كُنتُم غَيرَ مَدينينَ","simple_text":"فلولا إن كنتم غير مدينين"},{"sura_number":56,"ayah_number":87,"uthmani_text":"تَرجِعونَها إِن كُنتُم صـٰدِقينَ","simple_text":"ترجعونها إن كنتم صادقين"},{"sura_number":56,"ayah_number":88,"uthmani_text":"فَأَمّا إِن كانَ مِنَ المُقَرَّبينَ","simple_text":"فأما إن كان من المقربين"},{"sura_number":56,"ayah_number":89,"uthmani_text":"فَرَوحٌ وَرَيحانٌ وَجَنَّتُ نَعيمٍ","simple_text":"فروح وريحان وجنت نعيم"},{"sura_number":56,"ayah_number":90,"uthmani_text":"وَأَمّا إِن كانَ مِن أَصحـٰبِ اليَمينِ","simple_text":"وأما إن كان من أصحاب اليمين"},{"sura_number":56,"ayah_number":91,"uthmani_text":"فَسَلـٰمٌ لَكَ مِن أَصحـٰبِ اليَمينِ","simple_text":"فسلام لك من أصحاب اليمين"},{"sura_number":56,"ayah_number":92,"uthmani_text":"وَأَمّا إِن كانَ مِنَ المُكَذِّبينَ الضّالّينَ","simple_text":"وأما إن كان من المكذبين الضالين"},{"sura_number":56,"ayah_number":93,"uthmani_text":"فَنُزُلٌ مِن حَميمٍ","simple_text":"فنزل من حميم"},{"sura_number":56,"ayah_number":94,"uthmani_text":"وَتَصلِيَةُ جَحيمٍ","simple_text":"وتصلية جحيم"},{"sura_number":56,"ayah_number":95,"uthmani_text":"إِنَّ هـٰذا لَهُوَ حَقُّ اليَقينِ","simple_text":"إن هذا لهو حق اليقين"},{"sura_number":56,"ayah_number":96,"uthmani_text":"فَسَبِّح بِاسمِ رَبِّكَ العَظيمِ","simple_text":"فسبح باسم ربك العظيم"},{"sura_number":57,"ayah_number":1,"uthmani_text":"سَبَّحَ لِلَّهِ ما فِى السَّمـٰوٰتِ وَالأَرضِ ۖ وَهُوَ العَزيزُ الحَكيمُ","simple_text":"سبح لله ما في السماوات والأرض ۖ وهو العزيز الحكيم"},{"sura_number":57,"ayah_number":2,"uthmani_text":"لَهُ مُلكُ السَّمـٰوٰتِ وَالأَرضِ ۖ يُحيۦ وَيُميتُ ۖ وَهُوَ عَلىٰ كُلِّ شَىءٍ قَديرٌ","simple_text":"له ملك السماوات والأرض ۖ يحيي ويميت ۖ وهو على كل شيء قدير"},{"sura_number":57,"ayah_number":3,"uthmani_text":"هُوَ الأَوَّلُ وَالـٔاخِرُ وَالظّـٰهِرُ وَالباطِنُ ۖ وَهُوَ بِكُلِّ شَىءٍ عَليمٌ","simple_text":"هو الأول والآخر والظاهر والباطن ۖ وهو بكل شيء عليم"}]