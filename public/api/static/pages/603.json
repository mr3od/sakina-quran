[{"sura_number":109,"ayah_number":1,"uthmani_text":"قُل يـٰأَيُّهَا الكـٰفِرونَ","simple_text":"قل يا أيها الكافرون"},{"sura_number":109,"ayah_number":2,"uthmani_text":"لا أَعبُدُ ما تَعبُدونَ","simple_text":"لا أعبد ما تعبدون"},{"sura_number":109,"ayah_number":3,"uthmani_text":"وَلا أَنتُم عـٰبِدونَ ما أَعبُدُ","simple_text":"ولا أنتم عابدون ما أعبد"},{"sura_number":109,"ayah_number":4,"uthmani_text":"وَلا أَنا۠ عابِدٌ ما عَبَدتُم","simple_text":"ولا أنا عابد ما عبدتم"},{"sura_number":109,"ayah_number":5,"uthmani_text":"وَلا أَنتُم عـٰبِدونَ ما أَعبُدُ","simple_text":"ولا أنتم عابدون ما أعبد"},{"sura_number":109,"ayah_number":6,"uthmani_text":"لَكُم دينُكُم وَلِىَ دينِ","simple_text":"لكم دينكم ولي دين"},{"sura_number":110,"ayah_number":1,"uthmani_text":"إِذا جاءَ نَصرُ اللَّهِ وَالفَتحُ","simple_text":"إذا جاء نصر الله والفتح"},{"sura_number":110,"ayah_number":2,"uthmani_text":"وَرَأَيتَ النّاسَ يَدخُلونَ فى دينِ اللَّهِ أَفواجًا","simple_text":"ورأيت الناس يدخلون في دين الله أفواجا"},{"sura_number":110,"ayah_number":3,"uthmani_text":"فَسَبِّح بِحَمدِ رَبِّكَ وَاستَغفِرهُ ۚ إِنَّهُ كانَ تَوّابًا","simple_text":"فسبح بحمد ربك واستغفره ۚ إنه كان توابا"},{"sura_number":111,"ayah_number":1,"uthmani_text":"تَبَّت يَدا أَبى لَهَبٍ وَتَبَّ","simple_text":"تبت يدا أبي لهب وتب"},{"sura_number":111,"ayah_number":2,"uthmani_text":"ما أَغنىٰ عَنهُ مالُهُ وَما كَسَبَ","simple_text":"ما أغنى عنه ماله وما كسب"},{"sura_number":111,"ayah_number":3,"uthmani_text":"سَيَصلىٰ نارًا ذاتَ لَهَبٍ","simple_text":"سيصلى نارا ذات لهب"},{"sura_number":111,"ayah_number":4,"uthmani_text":"وَامرَأَتُهُ حَمّالَةَ الحَطَبِ","simple_text":"وامرأته حمالة الحطب"},{"sura_number":111,"ayah_number":5,"uthmani_text":"فى جيدِها حَبلٌ مِن مَسَدٍ","simple_text":"في جيدها حبل من مسد"}]