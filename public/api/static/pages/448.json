[{"sura_number":37,"ayah_number":52,"uthmani_text":"يَقولُ أَءِنَّكَ لَمِنَ المُصَدِّقينَ","simple_text":"يقول أإنك لمن المصدقين"},{"sura_number":37,"ayah_number":53,"uthmani_text":"أَءِذا مِتنا وَكُنّا تُرابًا وَعِظـٰمًا أَءِنّا لَمَدينونَ","simple_text":"أإذا متنا وكنا ترابا وعظاما أإنا لمدينون"},{"sura_number":37,"ayah_number":54,"uthmani_text":"قالَ هَل أَنتُم مُطَّلِعونَ","simple_text":"قال هل أنتم مطلعون"},{"sura_number":37,"ayah_number":55,"uthmani_text":"فَاطَّلَعَ فَرَءاهُ فى سَواءِ الجَحيمِ","simple_text":"فاطلع فرآه في سواء الجحيم"},{"sura_number":37,"ayah_number":56,"uthmani_text":"قالَ تَاللَّهِ إِن كِدتَ لَتُردينِ","simple_text":"قال تالله إن كدت لتردين"},{"sura_number":37,"ayah_number":57,"uthmani_text":"وَلَولا نِعمَةُ رَبّى لَكُنتُ مِنَ المُحضَرينَ","simple_text":"ولولا نعمة ربي لكنت من المحضرين"},{"sura_number":37,"ayah_number":58,"uthmani_text":"أَفَما نَحنُ بِمَيِّتينَ","simple_text":"أفما نحن بميتين"},{"sura_number":37,"ayah_number":59,"uthmani_text":"إِلّا مَوتَتَنَا الأولىٰ وَما نَحنُ بِمُعَذَّبينَ","simple_text":"إلا موتتنا الأولى وما نحن بمعذبين"},{"sura_number":37,"ayah_number":60,"uthmani_text":"إِنَّ هـٰذا لَهُوَ الفَوزُ العَظيمُ","simple_text":"إن هذا لهو الفوز العظيم"},{"sura_number":37,"ayah_number":61,"uthmani_text":"لِمِثلِ هـٰذا فَليَعمَلِ العـٰمِلونَ","simple_text":"لمثل هذا فليعمل العاملون"},{"sura_number":37,"ayah_number":62,"uthmani_text":"أَذٰلِكَ خَيرٌ نُزُلًا أَم شَجَرَةُ الزَّقّومِ","simple_text":"أذلك خير نزلا أم شجرة الزقوم"},{"sura_number":37,"ayah_number":63,"uthmani_text":"إِنّا جَعَلنـٰها فِتنَةً لِلظّـٰلِمينَ","simple_text":"إنا جعلناها فتنة للظالمين"},{"sura_number":37,"ayah_number":64,"uthmani_text":"إِنَّها شَجَرَةٌ تَخرُجُ فى أَصلِ الجَحيمِ","simple_text":"إنها شجرة تخرج في أصل الجحيم"},{"sura_number":37,"ayah_number":65,"uthmani_text":"طَلعُها كَأَنَّهُ رُءوسُ الشَّيـٰطينِ","simple_text":"طلعها كأنه رءوس الشياطين"},{"sura_number":37,"ayah_number":66,"uthmani_text":"فَإِنَّهُم لَـٔاكِلونَ مِنها فَمالِـٔونَ مِنهَا البُطونَ","simple_text":"فإنهم لآكلون منها فمالئون منها البطون"},{"sura_number":37,"ayah_number":67,"uthmani_text":"ثُمَّ إِنَّ لَهُم عَلَيها لَشَوبًا مِن حَميمٍ","simple_text":"ثم إن لهم عليها لشوبا من حميم"},{"sura_number":37,"ayah_number":68,"uthmani_text":"ثُمَّ إِنَّ مَرجِعَهُم لَإِلَى الجَحيمِ","simple_text":"ثم إن مرجعهم لإلى الجحيم"},{"sura_number":37,"ayah_number":69,"uthmani_text":"إِنَّهُم أَلفَوا ءاباءَهُم ضالّينَ","simple_text":"إنهم ألفوا آباءهم ضالين"},{"sura_number":37,"ayah_number":70,"uthmani_text":"فَهُم عَلىٰ ءاثـٰرِهِم يُهرَعونَ","simple_text":"فهم على آثارهم يهرعون"},{"sura_number":37,"ayah_number":71,"uthmani_text":"وَلَقَد ضَلَّ قَبلَهُم أَكثَرُ الأَوَّلينَ","simple_text":"ولقد ضل قبلهم أكثر الأولين"},{"sura_number":37,"ayah_number":72,"uthmani_text":"وَلَقَد أَرسَلنا فيهِم مُنذِرينَ","simple_text":"ولقد أرسلنا فيهم منذرين"},{"sura_number":37,"ayah_number":73,"uthmani_text":"فَانظُر كَيفَ كانَ عـٰقِبَةُ المُنذَرينَ","simple_text":"فانظر كيف كان عاقبة المنذرين"},{"sura_number":37,"ayah_number":74,"uthmani_text":"إِلّا عِبادَ اللَّهِ المُخلَصينَ","simple_text":"إلا عباد الله المخلصين"},{"sura_number":37,"ayah_number":75,"uthmani_text":"وَلَقَد نادىٰنا نوحٌ فَلَنِعمَ المُجيبونَ","simple_text":"ولقد نادانا نوح فلنعم المجيبون"},{"sura_number":37,"ayah_number":76,"uthmani_text":"وَنَجَّينـٰهُ وَأَهلَهُ مِنَ الكَربِ العَظيمِ","simple_text":"ونجيناه وأهله من الكرب العظيم"}]