[{"sura_number":69,"ayah_number":35,"uthmani_text":"فَلَيسَ لَهُ اليَومَ هـٰهُنا حَميمٌ","simple_text":"فليس له اليوم هاهنا حميم"},{"sura_number":69,"ayah_number":36,"uthmani_text":"وَلا طَعامٌ إِلّا مِن غِسلينٍ","simple_text":"ولا طعام إلا من غسلين"},{"sura_number":69,"ayah_number":37,"uthmani_text":"لا يَأكُلُهُ إِلَّا الخـٰطِـٔونَ","simple_text":"لا يأكله إلا الخاطئون"},{"sura_number":69,"ayah_number":38,"uthmani_text":"فَلا أُقسِمُ بِما تُبصِرونَ","simple_text":"فلا أقسم بما تبصرون"},{"sura_number":69,"ayah_number":39,"uthmani_text":"وَما لا تُبصِرونَ","simple_text":"وما لا تبصرون"},{"sura_number":69,"ayah_number":40,"uthmani_text":"إِنَّهُ لَقَولُ رَسولٍ كَريمٍ","simple_text":"إنه لقول رسول كريم"},{"sura_number":69,"ayah_number":41,"uthmani_text":"وَما هُوَ بِقَولِ شاعِرٍ ۚ قَليلًا ما تُؤمِنونَ","simple_text":"وما هو بقول شاعر ۚ قليلا ما تؤمنون"},{"sura_number":69,"ayah_number":42,"uthmani_text":"وَلا بِقَولِ كاهِنٍ ۚ قَليلًا ما تَذَكَّرونَ","simple_text":"ولا بقول كاهن ۚ قليلا ما تذكرون"},{"sura_number":69,"ayah_number":43,"uthmani_text":"تَنزيلٌ مِن رَبِّ العـٰلَمينَ","simple_text":"تنزيل من رب العالمين"},{"sura_number":69,"ayah_number":44,"uthmani_text":"وَلَو تَقَوَّلَ عَلَينا بَعضَ الأَقاويلِ","simple_text":"ولو تقول علينا بعض الأقاويل"},{"sura_number":69,"ayah_number":45,"uthmani_text":"لَأَخَذنا مِنهُ بِاليَمينِ","simple_text":"لأخذنا منه باليمين"},{"sura_number":69,"ayah_number":46,"uthmani_text":"ثُمَّ لَقَطَعنا مِنهُ الوَتينَ","simple_text":"ثم لقطعنا منه الوتين"},{"sura_number":69,"ayah_number":47,"uthmani_text":"فَما مِنكُم مِن أَحَدٍ عَنهُ حـٰجِزينَ","simple_text":"فما منكم من أحد عنه حاجزين"},{"sura_number":69,"ayah_number":48,"uthmani_text":"وَإِنَّهُ لَتَذكِرَةٌ لِلمُتَّقينَ","simple_text":"وإنه لتذكرة للمتقين"},{"sura_number":69,"ayah_number":49,"uthmani_text":"وَإِنّا لَنَعلَمُ أَنَّ مِنكُم مُكَذِّبينَ","simple_text":"وإنا لنعلم أن منكم مكذبين"},{"sura_number":69,"ayah_number":50,"uthmani_text":"وَإِنَّهُ لَحَسرَةٌ عَلَى الكـٰفِرينَ","simple_text":"وإنه لحسرة على الكافرين"},{"sura_number":69,"ayah_number":51,"uthmani_text":"وَإِنَّهُ لَحَقُّ اليَقينِ","simple_text":"وإنه لحق اليقين"},{"sura_number":69,"ayah_number":52,"uthmani_text":"فَسَبِّح بِاسمِ رَبِّكَ العَظيمِ","simple_text":"فسبح باسم ربك العظيم"},{"sura_number":70,"ayah_number":1,"uthmani_text":"سَأَلَ سائِلٌ بِعَذابٍ واقِعٍ","simple_text":"سأل سائل بعذاب واقع"},{"sura_number":70,"ayah_number":2,"uthmani_text":"لِلكـٰفِرينَ لَيسَ لَهُ دافِعٌ","simple_text":"للكافرين ليس له دافع"},{"sura_number":70,"ayah_number":3,"uthmani_text":"مِنَ اللَّهِ ذِى المَعارِجِ","simple_text":"من الله ذي المعارج"},{"sura_number":70,"ayah_number":4,"uthmani_text":"تَعرُجُ المَلـٰئِكَةُ وَالرّوحُ إِلَيهِ فى يَومٍ كانَ مِقدارُهُ خَمسينَ أَلفَ سَنَةٍ","simple_text":"تعرج الملائكة والروح إليه في يوم كان مقداره خمسين ألف سنة"},{"sura_number":70,"ayah_number":5,"uthmani_text":"فَاصبِر صَبرًا جَميلًا","simple_text":"فاصبر صبرا جميلا"},{"sura_number":70,"ayah_number":6,"uthmani_text":"إِنَّهُم يَرَونَهُ بَعيدًا","simple_text":"إنهم يرونه بعيدا"},{"sura_number":70,"ayah_number":7,"uthmani_text":"وَنَرىٰهُ قَريبًا","simple_text":"ونراه قريبا"},{"sura_number":70,"ayah_number":8,"uthmani_text":"يَومَ تَكونُ السَّماءُ كَالمُهلِ","simple_text":"يوم تكون السماء كالمهل"},{"sura_number":70,"ayah_number":9,"uthmani_text":"وَتَكونُ الجِبالُ كَالعِهنِ","simple_text":"وتكون الجبال كالعهن"},{"sura_number":70,"ayah_number":10,"uthmani_text":"وَلا يَسـَٔلُ حَميمٌ حَميمًا","simple_text":"ولا يسأل حميم حميما"}]