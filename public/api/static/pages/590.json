[{"sura_number":85,"ayah_number":1,"uthmani_text":"وَالسَّماءِ ذاتِ البُروجِ","simple_text":"والسماء ذات البروج"},{"sura_number":85,"ayah_number":2,"uthmani_text":"وَاليَومِ المَوعودِ","simple_text":"واليوم الموعود"},{"sura_number":85,"ayah_number":3,"uthmani_text":"وَشاهِدٍ وَمَشهودٍ","simple_text":"وشاهد ومشهود"},{"sura_number":85,"ayah_number":4,"uthmani_text":"قُتِلَ أَصحـٰبُ الأُخدودِ","simple_text":"قتل أصحاب الأخدود"},{"sura_number":85,"ayah_number":5,"uthmani_text":"النّارِ ذاتِ الوَقودِ","simple_text":"النار ذات الوقود"},{"sura_number":85,"ayah_number":6,"uthmani_text":"إِذ هُم عَلَيها قُعودٌ","simple_text":"إذ هم عليها قعود"},{"sura_number":85,"ayah_number":7,"uthmani_text":"وَهُم عَلىٰ ما يَفعَلونَ بِالمُؤمِنينَ شُهودٌ","simple_text":"وهم على ما يفعلون بالمؤمنين شهود"},{"sura_number":85,"ayah_number":8,"uthmani_text":"وَما نَقَموا مِنهُم إِلّا أَن يُؤمِنوا بِاللَّهِ العَزيزِ الحَميدِ","simple_text":"وما نقموا منهم إلا أن يؤمنوا بالله العزيز الحميد"},{"sura_number":85,"ayah_number":9,"uthmani_text":"الَّذى لَهُ مُلكُ السَّمـٰوٰتِ وَالأَرضِ ۚ وَاللَّهُ عَلىٰ كُلِّ شَىءٍ شَهيدٌ","simple_text":"الذي له ملك السماوات والأرض ۚ والله على كل شيء شهيد"},{"sura_number":85,"ayah_number":10,"uthmani_text":"إِنَّ الَّذينَ فَتَنُوا المُؤمِنينَ وَالمُؤمِنـٰتِ ثُمَّ لَم يَتوبوا فَلَهُم عَذابُ جَهَنَّمَ وَلَهُم عَذابُ الحَريقِ","simple_text":"إن الذين فتنوا المؤمنين والمؤمنات ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق"},{"sura_number":85,"ayah_number":11,"uthmani_text":"إِنَّ الَّذينَ ءامَنوا وَعَمِلُوا الصّـٰلِحـٰتِ لَهُم جَنّـٰتٌ تَجرى مِن تَحتِهَا الأَنهـٰرُ ۚ ذٰلِكَ الفَوزُ الكَبيرُ","simple_text":"إن الذين آمنوا وعملوا الصالحات لهم جنات تجري من تحتها الأنهار ۚ ذلك الفوز الكبير"},{"sura_number":85,"ayah_number":12,"uthmani_text":"إِنَّ بَطشَ رَبِّكَ لَشَديدٌ","simple_text":"إن بطش ربك لشديد"},{"sura_number":85,"ayah_number":13,"uthmani_text":"إِنَّهُ هُوَ يُبدِئُ وَيُعيدُ","simple_text":"إنه هو يبدئ ويعيد"},{"sura_number":85,"ayah_number":14,"uthmani_text":"وَهُوَ الغَفورُ الوَدودُ","simple_text":"وهو الغفور الودود"},{"sura_number":85,"ayah_number":15,"uthmani_text":"ذُو العَرشِ المَجيدُ","simple_text":"ذو العرش المجيد"},{"sura_number":85,"ayah_number":16,"uthmani_text":"فَعّالٌ لِما يُريدُ","simple_text":"فعال لما يريد"},{"sura_number":85,"ayah_number":17,"uthmani_text":"هَل أَتىٰكَ حَديثُ الجُنودِ","simple_text":"هل أتاك حديث الجنود"},{"sura_number":85,"ayah_number":18,"uthmani_text":"فِرعَونَ وَثَمودَ","simple_text":"فرعون وثمود"},{"sura_number":85,"ayah_number":19,"uthmani_text":"بَلِ الَّذينَ كَفَروا فى تَكذيبٍ","simple_text":"بل الذين كفروا في تكذيب"},{"sura_number":85,"ayah_number":20,"uthmani_text":"وَاللَّهُ مِن وَرائِهِم مُحيطٌ","simple_text":"والله من ورائهم محيط"},{"sura_number":85,"ayah_number":21,"uthmani_text":"بَل هُوَ قُرءانٌ مَجيدٌ","simple_text":"بل هو قرآن مجيد"},{"sura_number":85,"ayah_number":22,"uthmani_text":"فى لَوحٍ مَحفوظٍ","simple_text":"في لوح محفوظ"}]