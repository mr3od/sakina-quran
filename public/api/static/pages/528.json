[{"sura_number":53,"ayah_number":45,"uthmani_text":"وَأَنَّهُ خَلَقَ الزَّوجَينِ الذَّكَرَ وَالأُنثىٰ","simple_text":"وأنه خلق الزوجين الذكر والأنثى"},{"sura_number":53,"ayah_number":46,"uthmani_text":"مِن نُطفَةٍ إِذا تُمنىٰ","simple_text":"من نطفة إذا تمنى"},{"sura_number":53,"ayah_number":47,"uthmani_text":"وَأَنَّ عَلَيهِ النَّشأَةَ الأُخرىٰ","simple_text":"وأن عليه النشأة الأخرى"},{"sura_number":53,"ayah_number":48,"uthmani_text":"وَأَنَّهُ هُوَ أَغنىٰ وَأَقنىٰ","simple_text":"وأنه هو أغنى وأقنى"},{"sura_number":53,"ayah_number":49,"uthmani_text":"وَأَنَّهُ هُوَ رَبُّ الشِّعرىٰ","simple_text":"وأنه هو رب الشعرى"},{"sura_number":53,"ayah_number":50,"uthmani_text":"وَأَنَّهُ أَهلَكَ عادًا الأولىٰ","simple_text":"وأنه أهلك عادا الأولى"},{"sura_number":53,"ayah_number":51,"uthmani_text":"وَثَمودَا۟ فَما أَبقىٰ","simple_text":"وثمود فما أبقى"},{"sura_number":53,"ayah_number":52,"uthmani_text":"وَقَومَ نوحٍ مِن قَبلُ ۖ إِنَّهُم كانوا هُم أَظلَمَ وَأَطغىٰ","simple_text":"وقوم نوح من قبل ۖ إنهم كانوا هم أظلم وأطغى"},{"sura_number":53,"ayah_number":53,"uthmani_text":"وَالمُؤتَفِكَةَ أَهوىٰ","simple_text":"والمؤتفكة أهوى"},{"sura_number":53,"ayah_number":54,"uthmani_text":"فَغَشّىٰها ما غَشّىٰ","simple_text":"فغشاها ما غشى"},{"sura_number":53,"ayah_number":55,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكَ تَتَمارىٰ","simple_text":"فبأي آلاء ربك تتمارى"},{"sura_number":53,"ayah_number":56,"uthmani_text":"هـٰذا نَذيرٌ مِنَ النُّذُرِ الأولىٰ","simple_text":"هذا نذير من النذر الأولى"},{"sura_number":53,"ayah_number":57,"uthmani_text":"أَزِفَتِ الـٔازِفَةُ","simple_text":"أزفت الآزفة"},{"sura_number":53,"ayah_number":58,"uthmani_text":"لَيسَ لَها مِن دونِ اللَّهِ كاشِفَةٌ","simple_text":"ليس لها من دون الله كاشفة"},{"sura_number":53,"ayah_number":59,"uthmani_text":"أَفَمِن هـٰذَا الحَديثِ تَعجَبونَ","simple_text":"أفمن هذا الحديث تعجبون"},{"sura_number":53,"ayah_number":60,"uthmani_text":"وَتَضحَكونَ وَلا تَبكونَ","simple_text":"وتضحكون ولا تبكون"},{"sura_number":53,"ayah_number":61,"uthmani_text":"وَأَنتُم سـٰمِدونَ","simple_text":"وأنتم سامدون"},{"sura_number":53,"ayah_number":62,"uthmani_text":"فَاسجُدوا لِلَّهِ وَاعبُدوا ۩","simple_text":"فاسجدوا لله واعبدوا ۩"},{"sura_number":54,"ayah_number":1,"uthmani_text":"اقتَرَبَتِ السّاعَةُ وَانشَقَّ القَمَرُ","simple_text":"اقتربت الساعة وانشق القمر"},{"sura_number":54,"ayah_number":2,"uthmani_text":"وَإِن يَرَوا ءايَةً يُعرِضوا وَيَقولوا سِحرٌ مُستَمِرٌّ","simple_text":"وإن يروا آية يعرضوا ويقولوا سحر مستمر"},{"sura_number":54,"ayah_number":3,"uthmani_text":"وَكَذَّبوا وَاتَّبَعوا أَهواءَهُم ۚ وَكُلُّ أَمرٍ مُستَقِرٌّ","simple_text":"وكذبوا واتبعوا أهواءهم ۚ وكل أمر مستقر"},{"sura_number":54,"ayah_number":4,"uthmani_text":"وَلَقَد جاءَهُم مِنَ الأَنباءِ ما فيهِ مُزدَجَرٌ","simple_text":"ولقد جاءهم من الأنباء ما فيه مزدجر"},{"sura_number":54,"ayah_number":5,"uthmani_text":"حِكمَةٌ بـٰلِغَةٌ ۖ فَما تُغنِ النُّذُرُ","simple_text":"حكمة بالغة ۖ فما تغن النذر"},{"sura_number":54,"ayah_number":6,"uthmani_text":"فَتَوَلَّ عَنهُم ۘ يَومَ يَدعُ الدّاعِ إِلىٰ شَىءٍ نُكُرٍ","simple_text":"فتول عنهم ۘ يوم يدع الداع إلى شيء نكر"}]