[{"sura_number":103,"ayah_number":1,"uthmani_text":"وَالعَصرِ","simple_text":"والعصر"},{"sura_number":103,"ayah_number":2,"uthmani_text":"إِنَّ الإِنسـٰنَ لَفى خُسرٍ","simple_text":"إن الإنسان لفي خسر"},{"sura_number":103,"ayah_number":3,"uthmani_text":"إِلَّا الَّذينَ ءامَنوا وَعَمِلُوا الصّـٰلِحـٰتِ وَتَواصَوا بِالحَقِّ وَتَواصَوا بِالصَّبرِ","simple_text":"إلا الذين آمنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر"},{"sura_number":104,"ayah_number":1,"uthmani_text":"وَيلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ","simple_text":"ويل لكل همزة لمزة"},{"sura_number":104,"ayah_number":2,"uthmani_text":"الَّذى جَمَعَ مالًا وَعَدَّدَهُ","simple_text":"الذي جمع مالا وعدده"},{"sura_number":104,"ayah_number":3,"uthmani_text":"يَحسَبُ أَنَّ مالَهُ أَخلَدَهُ","simple_text":"يحسب أن ماله أخلده"},{"sura_number":104,"ayah_number":4,"uthmani_text":"كَلّا ۖ لَيُنبَذَنَّ فِى الحُطَمَةِ","simple_text":"كلا ۖ لينبذن في الحطمة"},{"sura_number":104,"ayah_number":5,"uthmani_text":"وَما أَدرىٰكَ مَا الحُطَمَةُ","simple_text":"وما أدراك ما الحطمة"},{"sura_number":104,"ayah_number":6,"uthmani_text":"نارُ اللَّهِ الموقَدَةُ","simple_text":"نار الله الموقدة"},{"sura_number":104,"ayah_number":7,"uthmani_text":"الَّتى تَطَّلِعُ عَلَى الأَفـِٔدَةِ","simple_text":"التي تطلع على الأفئدة"},{"sura_number":104,"ayah_number":8,"uthmani_text":"إِنَّها عَلَيهِم مُؤصَدَةٌ","simple_text":"إنها عليهم مؤصدة"},{"sura_number":104,"ayah_number":9,"uthmani_text":"فى عَمَدٍ مُمَدَّدَةٍ","simple_text":"في عمد ممددة"},{"sura_number":105,"ayah_number":1,"uthmani_text":"أَلَم تَرَ كَيفَ فَعَلَ رَبُّكَ بِأَصحـٰبِ الفيلِ","simple_text":"ألم تر كيف فعل ربك بأصحاب الفيل"},{"sura_number":105,"ayah_number":2,"uthmani_text":"أَلَم يَجعَل كَيدَهُم فى تَضليلٍ","simple_text":"ألم يجعل كيدهم في تضليل"},{"sura_number":105,"ayah_number":3,"uthmani_text":"وَأَرسَلَ عَلَيهِم طَيرًا أَبابيلَ","simple_text":"وأرسل عليهم طيرا أبابيل"},{"sura_number":105,"ayah_number":4,"uthmani_text":"تَرميهِم بِحِجارَةٍ مِن سِجّيلٍ","simple_text":"ترميهم بحجارة من سجيل"},{"sura_number":105,"ayah_number":5,"uthmani_text":"فَجَعَلَهُم كَعَصفٍ مَأكولٍ","simple_text":"فجعلهم كعصف مأكول"}]