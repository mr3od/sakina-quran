[{"sura_number":74,"ayah_number":48,"uthmani_text":"فَما تَنفَعُهُم شَفـٰعَةُ الشّـٰفِعينَ","simple_text":"فما تنفعهم شفاعة الشافعين"},{"sura_number":74,"ayah_number":49,"uthmani_text":"فَما لَهُم عَنِ التَّذكِرَةِ مُعرِضينَ","simple_text":"فما لهم عن التذكرة معرضين"},{"sura_number":74,"ayah_number":50,"uthmani_text":"كَأَنَّهُم حُمُرٌ مُستَنفِرَةٌ","simple_text":"كأنهم حمر مستنفرة"},{"sura_number":74,"ayah_number":51,"uthmani_text":"فَرَّت مِن قَسوَرَةٍ","simple_text":"فرت من قسورة"},{"sura_number":74,"ayah_number":52,"uthmani_text":"بَل يُريدُ كُلُّ امرِئٍ مِنهُم أَن يُؤتىٰ صُحُفًا مُنَشَّرَةً","simple_text":"بل يريد كل امرئ منهم أن يؤتى صحفا منشرة"},{"sura_number":74,"ayah_number":53,"uthmani_text":"كَلّا ۖ بَل لا يَخافونَ الـٔاخِرَةَ","simple_text":"كلا ۖ بل لا يخافون الآخرة"},{"sura_number":74,"ayah_number":54,"uthmani_text":"كَلّا إِنَّهُ تَذكِرَةٌ","simple_text":"كلا إنه تذكرة"},{"sura_number":74,"ayah_number":55,"uthmani_text":"فَمَن شاءَ ذَكَرَهُ","simple_text":"فمن شاء ذكره"},{"sura_number":74,"ayah_number":56,"uthmani_text":"وَما يَذكُرونَ إِلّا أَن يَشاءَ اللَّهُ ۚ هُوَ أَهلُ التَّقوىٰ وَأَهلُ المَغفِرَةِ","simple_text":"وما يذكرون إلا أن يشاء الله ۚ هو أهل التقوى وأهل المغفرة"},{"sura_number":75,"ayah_number":1,"uthmani_text":"لا أُقسِمُ بِيَومِ القِيـٰمَةِ","simple_text":"لا أقسم بيوم القيامة"},{"sura_number":75,"ayah_number":2,"uthmani_text":"وَلا أُقسِمُ بِالنَّفسِ اللَّوّامَةِ","simple_text":"ولا أقسم بالنفس اللوامة"},{"sura_number":75,"ayah_number":3,"uthmani_text":"أَيَحسَبُ الإِنسـٰنُ أَلَّن نَجمَعَ عِظامَهُ","simple_text":"أيحسب الإنسان ألن نجمع عظامه"},{"sura_number":75,"ayah_number":4,"uthmani_text":"بَلىٰ قـٰدِرينَ عَلىٰ أَن نُسَوِّىَ بَنانَهُ","simple_text":"بلى قادرين على أن نسوي بنانه"},{"sura_number":75,"ayah_number":5,"uthmani_text":"بَل يُريدُ الإِنسـٰنُ لِيَفجُرَ أَمامَهُ","simple_text":"بل يريد الإنسان ليفجر أمامه"},{"sura_number":75,"ayah_number":6,"uthmani_text":"يَسـَٔلُ أَيّانَ يَومُ القِيـٰمَةِ","simple_text":"يسأل أيان يوم القيامة"},{"sura_number":75,"ayah_number":7,"uthmani_text":"فَإِذا بَرِقَ البَصَرُ","simple_text":"فإذا برق البصر"},{"sura_number":75,"ayah_number":8,"uthmani_text":"وَخَسَفَ القَمَرُ","simple_text":"وخسف القمر"},{"sura_number":75,"ayah_number":9,"uthmani_text":"وَجُمِعَ الشَّمسُ وَالقَمَرُ","simple_text":"وجمع الشمس والقمر"},{"sura_number":75,"ayah_number":10,"uthmani_text":"يَقولُ الإِنسـٰنُ يَومَئِذٍ أَينَ المَفَرُّ","simple_text":"يقول الإنسان يومئذ أين المفر"},{"sura_number":75,"ayah_number":11,"uthmani_text":"كَلّا لا وَزَرَ","simple_text":"كلا لا وزر"},{"sura_number":75,"ayah_number":12,"uthmani_text":"إِلىٰ رَبِّكَ يَومَئِذٍ المُستَقَرُّ","simple_text":"إلى ربك يومئذ المستقر"},{"sura_number":75,"ayah_number":13,"uthmani_text":"يُنَبَّؤُا۟ الإِنسـٰنُ يَومَئِذٍ بِما قَدَّمَ وَأَخَّرَ","simple_text":"ينبأ الإنسان يومئذ بما قدم وأخر"},{"sura_number":75,"ayah_number":14,"uthmani_text":"بَلِ الإِنسـٰنُ عَلىٰ نَفسِهِ بَصيرَةٌ","simple_text":"بل الإنسان على نفسه بصيرة"},{"sura_number":75,"ayah_number":15,"uthmani_text":"وَلَو أَلقىٰ مَعاذيرَهُ","simple_text":"ولو ألقى معاذيره"},{"sura_number":75,"ayah_number":16,"uthmani_text":"لا تُحَرِّك بِهِ لِسانَكَ لِتَعجَلَ بِهِ","simple_text":"لا تحرك به لسانك لتعجل به"},{"sura_number":75,"ayah_number":17,"uthmani_text":"إِنَّ عَلَينا جَمعَهُ وَقُرءانَهُ","simple_text":"إن علينا جمعه وقرآنه"},{"sura_number":75,"ayah_number":18,"uthmani_text":"فَإِذا قَرَأنـٰهُ فَاتَّبِع قُرءانَهُ","simple_text":"فإذا قرأناه فاتبع قرآنه"},{"sura_number":75,"ayah_number":19,"uthmani_text":"ثُمَّ إِنَّ عَلَينا بَيانَهُ","simple_text":"ثم إن علينا بيانه"}]