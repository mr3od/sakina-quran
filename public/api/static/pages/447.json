[{"sura_number":37,"ayah_number":25,"uthmani_text":"ما لَكُم لا تَناصَرونَ","simple_text":"ما لكم لا تناصرون"},{"sura_number":37,"ayah_number":26,"uthmani_text":"بَل هُمُ اليَومَ مُستَسلِمونَ","simple_text":"بل هم اليوم مستسلمون"},{"sura_number":37,"ayah_number":27,"uthmani_text":"وَأَقبَلَ بَعضُهُم عَلىٰ بَعضٍ يَتَساءَلونَ","simple_text":"وأقبل بعضهم على بعض يتساءلون"},{"sura_number":37,"ayah_number":28,"uthmani_text":"قالوا إِنَّكُم كُنتُم تَأتونَنا عَنِ اليَمينِ","simple_text":"قالوا إنكم كنتم تأتوننا عن اليمين"},{"sura_number":37,"ayah_number":29,"uthmani_text":"قالوا بَل لَم تَكونوا مُؤمِنينَ","simple_text":"قالوا بل لم تكونوا مؤمنين"},{"sura_number":37,"ayah_number":30,"uthmani_text":"وَما كانَ لَنا عَلَيكُم مِن سُلطـٰنٍ ۖ بَل كُنتُم قَومًا طـٰغينَ","simple_text":"وما كان لنا عليكم من سلطان ۖ بل كنتم قوما طاغين"},{"sura_number":37,"ayah_number":31,"uthmani_text":"فَحَقَّ عَلَينا قَولُ رَبِّنا ۖ إِنّا لَذائِقونَ","simple_text":"فحق علينا قول ربنا ۖ إنا لذائقون"},{"sura_number":37,"ayah_number":32,"uthmani_text":"فَأَغوَينـٰكُم إِنّا كُنّا غـٰوينَ","simple_text":"فأغويناكم إنا كنا غاوين"},{"sura_number":37,"ayah_number":33,"uthmani_text":"فَإِنَّهُم يَومَئِذٍ فِى العَذابِ مُشتَرِكونَ","simple_text":"فإنهم يومئذ في العذاب مشتركون"},{"sura_number":37,"ayah_number":34,"uthmani_text":"إِنّا كَذٰلِكَ نَفعَلُ بِالمُجرِمينَ","simple_text":"إنا كذلك نفعل بالمجرمين"},{"sura_number":37,"ayah_number":35,"uthmani_text":"إِنَّهُم كانوا إِذا قيلَ لَهُم لا إِلـٰهَ إِلَّا اللَّهُ يَستَكبِرونَ","simple_text":"إنهم كانوا إذا قيل لهم لا إله إلا الله يستكبرون"},{"sura_number":37,"ayah_number":36,"uthmani_text":"وَيَقولونَ أَئِنّا لَتارِكوا ءالِهَتِنا لِشاعِرٍ مَجنونٍ","simple_text":"ويقولون أئنا لتاركو آلهتنا لشاعر مجنون"},{"sura_number":37,"ayah_number":37,"uthmani_text":"بَل جاءَ بِالحَقِّ وَصَدَّقَ المُرسَلينَ","simple_text":"بل جاء بالحق وصدق المرسلين"},{"sura_number":37,"ayah_number":38,"uthmani_text":"إِنَّكُم لَذائِقُوا العَذابِ الأَليمِ","simple_text":"إنكم لذائقو العذاب الأليم"},{"sura_number":37,"ayah_number":39,"uthmani_text":"وَما تُجزَونَ إِلّا ما كُنتُم تَعمَلونَ","simple_text":"وما تجزون إلا ما كنتم تعملون"},{"sura_number":37,"ayah_number":40,"uthmani_text":"إِلّا عِبادَ اللَّهِ المُخلَصينَ","simple_text":"إلا عباد الله المخلصين"},{"sura_number":37,"ayah_number":41,"uthmani_text":"أُولـٰئِكَ لَهُم رِزقٌ مَعلومٌ","simple_text":"أولئك لهم رزق معلوم"},{"sura_number":37,"ayah_number":42,"uthmani_text":"فَوٰكِهُ ۖ وَهُم مُكرَمونَ","simple_text":"فواكه ۖ وهم مكرمون"},{"sura_number":37,"ayah_number":43,"uthmani_text":"فى جَنّـٰتِ النَّعيمِ","simple_text":"في جنات النعيم"},{"sura_number":37,"ayah_number":44,"uthmani_text":"عَلىٰ سُرُرٍ مُتَقـٰبِلينَ","simple_text":"على سرر متقابلين"},{"sura_number":37,"ayah_number":45,"uthmani_text":"يُطافُ عَلَيهِم بِكَأسٍ مِن مَعينٍ","simple_text":"يطاف عليهم بكأس من معين"},{"sura_number":37,"ayah_number":46,"uthmani_text":"بَيضاءَ لَذَّةٍ لِلشّـٰرِبينَ","simple_text":"بيضاء لذة للشاربين"},{"sura_number":37,"ayah_number":47,"uthmani_text":"لا فيها غَولٌ وَلا هُم عَنها يُنزَفونَ","simple_text":"لا فيها غول ولا هم عنها ينزفون"},{"sura_number":37,"ayah_number":48,"uthmani_text":"وَعِندَهُم قـٰصِرٰتُ الطَّرفِ عينٌ","simple_text":"وعندهم قاصرات الطرف عين"},{"sura_number":37,"ayah_number":49,"uthmani_text":"كَأَنَّهُنَّ بَيضٌ مَكنونٌ","simple_text":"كأنهن بيض مكنون"},{"sura_number":37,"ayah_number":50,"uthmani_text":"فَأَقبَلَ بَعضُهُم عَلىٰ بَعضٍ يَتَساءَلونَ","simple_text":"فأقبل بعضهم على بعض يتساءلون"},{"sura_number":37,"ayah_number":51,"uthmani_text":"قالَ قائِلٌ مِنهُم إِنّى كانَ لى قَرينٌ","simple_text":"قال قائل منهم إني كان لي قرين"}]