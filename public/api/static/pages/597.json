[{"sura_number":95,"ayah_number":1,"uthmani_text":"وَالتّينِ وَالزَّيتونِ","simple_text":"والتين والزيتون"},{"sura_number":95,"ayah_number":2,"uthmani_text":"وَطورِ سينينَ","simple_text":"وطور سينين"},{"sura_number":95,"ayah_number":3,"uthmani_text":"وَهـٰذَا البَلَدِ الأَمينِ","simple_text":"وهذا البلد الأمين"},{"sura_number":95,"ayah_number":4,"uthmani_text":"لَقَد خَلَقنَا الإِنسـٰنَ فى أَحسَنِ تَقويمٍ","simple_text":"لقد خلقنا الإنسان في أحسن تقويم"},{"sura_number":95,"ayah_number":5,"uthmani_text":"ثُمَّ رَدَدنـٰهُ أَسفَلَ سـٰفِلينَ","simple_text":"ثم رددناه أسفل سافلين"},{"sura_number":95,"ayah_number":6,"uthmani_text":"إِلَّا الَّذينَ ءامَنوا وَعَمِلُوا الصّـٰلِحـٰتِ فَلَهُم أَجرٌ غَيرُ مَمنونٍ","simple_text":"إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون"},{"sura_number":95,"ayah_number":7,"uthmani_text":"فَما يُكَذِّبُكَ بَعدُ بِالدّينِ","simple_text":"فما يكذبك بعد بالدين"},{"sura_number":95,"ayah_number":8,"uthmani_text":"أَلَيسَ اللَّهُ بِأَحكَمِ الحـٰكِمينَ","simple_text":"أليس الله بأحكم الحاكمين"},{"sura_number":96,"ayah_number":1,"uthmani_text":"اقرَأ بِاسمِ رَبِّكَ الَّذى خَلَقَ","simple_text":"اقرأ باسم ربك الذي خلق"},{"sura_number":96,"ayah_number":2,"uthmani_text":"خَلَقَ الإِنسـٰنَ مِن عَلَقٍ","simple_text":"خلق الإنسان من علق"},{"sura_number":96,"ayah_number":3,"uthmani_text":"اقرَأ وَرَبُّكَ الأَكرَمُ","simple_text":"اقرأ وربك الأكرم"},{"sura_number":96,"ayah_number":4,"uthmani_text":"الَّذى عَلَّمَ بِالقَلَمِ","simple_text":"الذي علم بالقلم"},{"sura_number":96,"ayah_number":5,"uthmani_text":"عَلَّمَ الإِنسـٰنَ ما لَم يَعلَم","simple_text":"علم الإنسان ما لم يعلم"},{"sura_number":96,"ayah_number":6,"uthmani_text":"كَلّا إِنَّ الإِنسـٰنَ لَيَطغىٰ","simple_text":"كلا إن الإنسان ليطغى"},{"sura_number":96,"ayah_number":7,"uthmani_text":"أَن رَءاهُ استَغنىٰ","simple_text":"أن رآه استغنى"},{"sura_number":96,"ayah_number":8,"uthmani_text":"إِنَّ إِلىٰ رَبِّكَ الرُّجعىٰ","simple_text":"إن إلى ربك الرجعى"},{"sura_number":96,"ayah_number":9,"uthmani_text":"أَرَءَيتَ الَّذى يَنهىٰ","simple_text":"أرأيت الذي ينهى"},{"sura_number":96,"ayah_number":10,"uthmani_text":"عَبدًا إِذا صَلّىٰ","simple_text":"عبدا إذا صلى"},{"sura_number":96,"ayah_number":11,"uthmani_text":"أَرَءَيتَ إِن كانَ عَلَى الهُدىٰ","simple_text":"أرأيت إن كان على الهدى"},{"sura_number":96,"ayah_number":12,"uthmani_text":"أَو أَمَرَ بِالتَّقوىٰ","simple_text":"أو أمر بالتقوى"},{"sura_number":96,"ayah_number":13,"uthmani_text":"أَرَءَيتَ إِن كَذَّبَ وَتَوَلّىٰ","simple_text":"أرأيت إن كذب وتولى"},{"sura_number":96,"ayah_number":14,"uthmani_text":"أَلَم يَعلَم بِأَنَّ اللَّهَ يَرىٰ","simple_text":"ألم يعلم بأن الله يرى"},{"sura_number":96,"ayah_number":15,"uthmani_text":"كَلّا لَئِن لَم يَنتَهِ لَنَسفَعًا بِالنّاصِيَةِ","simple_text":"كلا لئن لم ينته لنسفعا بالناصية"},{"sura_number":96,"ayah_number":16,"uthmani_text":"ناصِيَةٍ كـٰذِبَةٍ خاطِئَةٍ","simple_text":"ناصية كاذبة خاطئة"},{"sura_number":96,"ayah_number":17,"uthmani_text":"فَليَدعُ نادِيَهُ","simple_text":"فليدع ناديه"},{"sura_number":96,"ayah_number":18,"uthmani_text":"سَنَدعُ الزَّبانِيَةَ","simple_text":"سندع الزبانية"},{"sura_number":96,"ayah_number":19,"uthmani_text":"كَلّا لا تُطِعهُ وَاسجُد وَاقتَرِب ۩","simple_text":"كلا لا تطعه واسجد واقترب ۩"}]