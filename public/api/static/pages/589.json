[{"sura_number":83,"ayah_number":35,"uthmani_text":"عَلَى الأَرائِكِ يَنظُرونَ","simple_text":"على الأرائك ينظرون"},{"sura_number":83,"ayah_number":36,"uthmani_text":"هَل ثُوِّبَ الكُفّارُ ما كانوا يَفعَلونَ","simple_text":"هل ثوب الكفار ما كانوا يفعلون"},{"sura_number":84,"ayah_number":1,"uthmani_text":"إِذَا السَّماءُ انشَقَّت","simple_text":"إذا السماء انشقت"},{"sura_number":84,"ayah_number":2,"uthmani_text":"وَأَذِنَت لِرَبِّها وَحُقَّت","simple_text":"وأذنت لربها وحقت"},{"sura_number":84,"ayah_number":3,"uthmani_text":"وَإِذَا الأَرضُ مُدَّت","simple_text":"وإذا الأرض مدت"},{"sura_number":84,"ayah_number":4,"uthmani_text":"وَأَلقَت ما فيها وَتَخَلَّت","simple_text":"وألقت ما فيها وتخلت"},{"sura_number":84,"ayah_number":5,"uthmani_text":"وَأَذِنَت لِرَبِّها وَحُقَّت","simple_text":"وأذنت لربها وحقت"},{"sura_number":84,"ayah_number":6,"uthmani_text":"يـٰأَيُّهَا الإِنسـٰنُ إِنَّكَ كادِحٌ إِلىٰ رَبِّكَ كَدحًا فَمُلـٰقيهِ","simple_text":"يا أيها الإنسان إنك كادح إلى ربك كدحا فملاقيه"},{"sura_number":84,"ayah_number":7,"uthmani_text":"فَأَمّا مَن أوتِىَ كِتـٰبَهُ بِيَمينِهِ","simple_text":"فأما من أوتي كتابه بيمينه"},{"sura_number":84,"ayah_number":8,"uthmani_text":"فَسَوفَ يُحاسَبُ حِسابًا يَسيرًا","simple_text":"فسوف يحاسب حسابا يسيرا"},{"sura_number":84,"ayah_number":9,"uthmani_text":"وَيَنقَلِبُ إِلىٰ أَهلِهِ مَسرورًا","simple_text":"وينقلب إلى أهله مسرورا"},{"sura_number":84,"ayah_number":10,"uthmani_text":"وَأَمّا مَن أوتِىَ كِتـٰبَهُ وَراءَ ظَهرِهِ","simple_text":"وأما من أوتي كتابه وراء ظهره"},{"sura_number":84,"ayah_number":11,"uthmani_text":"فَسَوفَ يَدعوا ثُبورًا","simple_text":"فسوف يدعو ثبورا"},{"sura_number":84,"ayah_number":12,"uthmani_text":"وَيَصلىٰ سَعيرًا","simple_text":"ويصلى سعيرا"},{"sura_number":84,"ayah_number":13,"uthmani_text":"إِنَّهُ كانَ فى أَهلِهِ مَسرورًا","simple_text":"إنه كان في أهله مسرورا"},{"sura_number":84,"ayah_number":14,"uthmani_text":"إِنَّهُ ظَنَّ أَن لَن يَحورَ","simple_text":"إنه ظن أن لن يحور"},{"sura_number":84,"ayah_number":15,"uthmani_text":"بَلىٰ إِنَّ رَبَّهُ كانَ بِهِ بَصيرًا","simple_text":"بلى إن ربه كان به بصيرا"},{"sura_number":84,"ayah_number":16,"uthmani_text":"فَلا أُقسِمُ بِالشَّفَقِ","simple_text":"فلا أقسم بالشفق"},{"sura_number":84,"ayah_number":17,"uthmani_text":"وَالَّيلِ وَما وَسَقَ","simple_text":"والليل وما وسق"},{"sura_number":84,"ayah_number":18,"uthmani_text":"وَالقَمَرِ إِذَا اتَّسَقَ","simple_text":"والقمر إذا اتسق"},{"sura_number":84,"ayah_number":19,"uthmani_text":"لَتَركَبُنَّ طَبَقًا عَن طَبَقٍ","simple_text":"لتركبن طبقا عن طبق"},{"sura_number":84,"ayah_number":20,"uthmani_text":"فَما لَهُم لا يُؤمِنونَ","simple_text":"فما لهم لا يؤمنون"},{"sura_number":84,"ayah_number":21,"uthmani_text":"وَإِذا قُرِئَ عَلَيهِمُ القُرءانُ لا يَسجُدونَ ۩","simple_text":"وإذا قرئ عليهم القرآن لا يسجدون ۩"},{"sura_number":84,"ayah_number":22,"uthmani_text":"بَلِ الَّذينَ كَفَروا يُكَذِّبونَ","simple_text":"بل الذين كفروا يكذبون"},{"sura_number":84,"ayah_number":23,"uthmani_text":"وَاللَّهُ أَعلَمُ بِما يوعونَ","simple_text":"والله أعلم بما يوعون"},{"sura_number":84,"ayah_number":24,"uthmani_text":"فَبَشِّرهُم بِعَذابٍ أَليمٍ","simple_text":"فبشرهم بعذاب أليم"},{"sura_number":84,"ayah_number":25,"uthmani_text":"إِلَّا الَّذينَ ءامَنوا وَعَمِلُوا الصّـٰلِحـٰتِ لَهُم أَجرٌ غَيرُ مَمنونٍ","simple_text":"إلا الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون"}]