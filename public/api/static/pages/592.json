[{"sura_number":87,"ayah_number":16,"uthmani_text":"بَل تُؤثِرونَ الحَيوٰةَ الدُّنيا","simple_text":"بل تؤثرون الحياة الدنيا"},{"sura_number":87,"ayah_number":17,"uthmani_text":"وَالـٔاخِرَةُ خَيرٌ وَأَبقىٰ","simple_text":"والآخرة خير وأبقى"},{"sura_number":87,"ayah_number":18,"uthmani_text":"إِنَّ هـٰذا لَفِى الصُّحُفِ الأولىٰ","simple_text":"إن هذا لفي الصحف الأولى"},{"sura_number":87,"ayah_number":19,"uthmani_text":"صُحُفِ إِبرٰهيمَ وَموسىٰ","simple_text":"صحف إبراهيم وموسى"},{"sura_number":88,"ayah_number":1,"uthmani_text":"هَل أَتىٰكَ حَديثُ الغـٰشِيَةِ","simple_text":"هل أتاك حديث الغاشية"},{"sura_number":88,"ayah_number":2,"uthmani_text":"وُجوهٌ يَومَئِذٍ خـٰشِعَةٌ","simple_text":"وجوه يومئذ خاشعة"},{"sura_number":88,"ayah_number":3,"uthmani_text":"عامِلَةٌ ناصِبَةٌ","simple_text":"عاملة ناصبة"},{"sura_number":88,"ayah_number":4,"uthmani_text":"تَصلىٰ نارًا حامِيَةً","simple_text":"تصلى نارا حامية"},{"sura_number":88,"ayah_number":5,"uthmani_text":"تُسقىٰ مِن عَينٍ ءانِيَةٍ","simple_text":"تسقى من عين آنية"},{"sura_number":88,"ayah_number":6,"uthmani_text":"لَيسَ لَهُم طَعامٌ إِلّا مِن ضَريعٍ","simple_text":"ليس لهم طعام إلا من ضريع"},{"sura_number":88,"ayah_number":7,"uthmani_text":"لا يُسمِنُ وَلا يُغنى مِن جوعٍ","simple_text":"لا يسمن ولا يغني من جوع"},{"sura_number":88,"ayah_number":8,"uthmani_text":"وُجوهٌ يَومَئِذٍ ناعِمَةٌ","simple_text":"وجوه يومئذ ناعمة"},{"sura_number":88,"ayah_number":9,"uthmani_text":"لِسَعيِها راضِيَةٌ","simple_text":"لسعيها راضية"},{"sura_number":88,"ayah_number":10,"uthmani_text":"فى جَنَّةٍ عالِيَةٍ","simple_text":"في جنة عالية"},{"sura_number":88,"ayah_number":11,"uthmani_text":"لا تَسمَعُ فيها لـٰغِيَةً","simple_text":"لا تسمع فيها لاغية"},{"sura_number":88,"ayah_number":12,"uthmani_text":"فيها عَينٌ جارِيَةٌ","simple_text":"فيها عين جارية"},{"sura_number":88,"ayah_number":13,"uthmani_text":"فيها سُرُرٌ مَرفوعَةٌ","simple_text":"فيها سرر مرفوعة"},{"sura_number":88,"ayah_number":14,"uthmani_text":"وَأَكوابٌ مَوضوعَةٌ","simple_text":"وأكواب موضوعة"},{"sura_number":88,"ayah_number":15,"uthmani_text":"وَنَمارِقُ مَصفوفَةٌ","simple_text":"ونمارق مصفوفة"},{"sura_number":88,"ayah_number":16,"uthmani_text":"وَزَرابِىُّ مَبثوثَةٌ","simple_text":"وزرابي مبثوثة"},{"sura_number":88,"ayah_number":17,"uthmani_text":"أَفَلا يَنظُرونَ إِلَى الإِبِلِ كَيفَ خُلِقَت","simple_text":"أفلا ينظرون إلى الإبل كيف خلقت"},{"sura_number":88,"ayah_number":18,"uthmani_text":"وَإِلَى السَّماءِ كَيفَ رُفِعَت","simple_text":"وإلى السماء كيف رفعت"},{"sura_number":88,"ayah_number":19,"uthmani_text":"وَإِلَى الجِبالِ كَيفَ نُصِبَت","simple_text":"وإلى الجبال كيف نصبت"},{"sura_number":88,"ayah_number":20,"uthmani_text":"وَإِلَى الأَرضِ كَيفَ سُطِحَت","simple_text":"وإلى الأرض كيف سطحت"},{"sura_number":88,"ayah_number":21,"uthmani_text":"فَذَكِّر إِنَّما أَنتَ مُذَكِّرٌ","simple_text":"فذكر إنما أنت مذكر"},{"sura_number":88,"ayah_number":22,"uthmani_text":"لَستَ عَلَيهِم بِمُصَيطِرٍ","simple_text":"لست عليهم بمصيطر"},{"sura_number":88,"ayah_number":23,"uthmani_text":"إِلّا مَن تَوَلّىٰ وَكَفَرَ","simple_text":"إلا من تولى وكفر"},{"sura_number":88,"ayah_number":24,"uthmani_text":"فَيُعَذِّبُهُ اللَّهُ العَذابَ الأَكبَرَ","simple_text":"فيعذبه الله العذاب الأكبر"},{"sura_number":88,"ayah_number":25,"uthmani_text":"إِنَّ إِلَينا إِيابَهُم","simple_text":"إن إلينا إيابهم"},{"sura_number":88,"ayah_number":26,"uthmani_text":"ثُمَّ إِنَّ عَلَينا حِسابَهُم","simple_text":"ثم إن علينا حسابهم"}]