[{"sura_number":20,"ayah_number":13,"uthmani_text":"وَأَنَا اختَرتُكَ فَاستَمِع لِما يوحىٰ","simple_text":"وأنا اخترتك فاستمع لما يوحى"},{"sura_number":20,"ayah_number":14,"uthmani_text":"إِنَّنى أَنَا اللَّهُ لا إِلـٰهَ إِلّا أَنا۠ فَاعبُدنى وَأَقِمِ الصَّلوٰةَ لِذِكرى","simple_text":"إنني أنا الله لا إله إلا أنا فاعبدني وأقم الصلاة لذكري"},{"sura_number":20,"ayah_number":15,"uthmani_text":"إِنَّ السّاعَةَ ءاتِيَةٌ أَكادُ أُخفيها لِتُجزىٰ كُلُّ نَفسٍ بِما تَسعىٰ","simple_text":"إن الساعة آتية أكاد أخفيها لتجزى كل نفس بما تسعى"},{"sura_number":20,"ayah_number":16,"uthmani_text":"فَلا يَصُدَّنَّكَ عَنها مَن لا يُؤمِنُ بِها وَاتَّبَعَ هَوىٰهُ فَتَردىٰ","simple_text":"فلا يصدنك عنها من لا يؤمن بها واتبع هواه فتردى"},{"sura_number":20,"ayah_number":17,"uthmani_text":"وَما تِلكَ بِيَمينِكَ يـٰموسىٰ","simple_text":"وما تلك بيمينك يا موسى"},{"sura_number":20,"ayah_number":18,"uthmani_text":"قالَ هِىَ عَصاىَ أَتَوَكَّؤُا۟ عَلَيها وَأَهُشُّ بِها عَلىٰ غَنَمى وَلِىَ فيها مَـٔارِبُ أُخرىٰ","simple_text":"قال هي عصاي أتوكأ عليها وأهش بها على غنمي ولي فيها مآرب أخرى"},{"sura_number":20,"ayah_number":19,"uthmani_text":"قالَ أَلقِها يـٰموسىٰ","simple_text":"قال ألقها يا موسى"},{"sura_number":20,"ayah_number":20,"uthmani_text":"فَأَلقىٰها فَإِذا هِىَ حَيَّةٌ تَسعىٰ","simple_text":"فألقاها فإذا هي حية تسعى"},{"sura_number":20,"ayah_number":21,"uthmani_text":"قالَ خُذها وَلا تَخَف ۖ سَنُعيدُها سيرَتَهَا الأولىٰ","simple_text":"قال خذها ولا تخف ۖ سنعيدها سيرتها الأولى"},{"sura_number":20,"ayah_number":22,"uthmani_text":"وَاضمُم يَدَكَ إِلىٰ جَناحِكَ تَخرُج بَيضاءَ مِن غَيرِ سوءٍ ءايَةً أُخرىٰ","simple_text":"واضمم يدك إلى جناحك تخرج بيضاء من غير سوء آية أخرى"},{"sura_number":20,"ayah_number":23,"uthmani_text":"لِنُرِيَكَ مِن ءايـٰتِنَا الكُبرَى","simple_text":"لنريك من آياتنا الكبرى"},{"sura_number":20,"ayah_number":24,"uthmani_text":"اذهَب إِلىٰ فِرعَونَ إِنَّهُ طَغىٰ","simple_text":"اذهب إلى فرعون إنه طغى"},{"sura_number":20,"ayah_number":25,"uthmani_text":"قالَ رَبِّ اشرَح لى صَدرى","simple_text":"قال رب اشرح لي صدري"},{"sura_number":20,"ayah_number":26,"uthmani_text":"وَيَسِّر لى أَمرى","simple_text":"ويسر لي أمري"},{"sura_number":20,"ayah_number":27,"uthmani_text":"وَاحلُل عُقدَةً مِن لِسانى","simple_text":"واحلل عقدة من لساني"},{"sura_number":20,"ayah_number":28,"uthmani_text":"يَفقَهوا قَولى","simple_text":"يفقهوا قولي"},{"sura_number":20,"ayah_number":29,"uthmani_text":"وَاجعَل لى وَزيرًا مِن أَهلى","simple_text":"واجعل لي وزيرا من أهلي"},{"sura_number":20,"ayah_number":30,"uthmani_text":"هـٰرونَ أَخِى","simple_text":"هارون أخي"},{"sura_number":20,"ayah_number":31,"uthmani_text":"اشدُد بِهِ أَزرى","simple_text":"اشدد به أزري"},{"sura_number":20,"ayah_number":32,"uthmani_text":"وَأَشرِكهُ فى أَمرى","simple_text":"وأشركه في أمري"},{"sura_number":20,"ayah_number":33,"uthmani_text":"كَى نُسَبِّحَكَ كَثيرًا","simple_text":"كي نسبحك كثيرا"},{"sura_number":20,"ayah_number":34,"uthmani_text":"وَنَذكُرَكَ كَثيرًا","simple_text":"ونذكرك كثيرا"},{"sura_number":20,"ayah_number":35,"uthmani_text":"إِنَّكَ كُنتَ بِنا بَصيرًا","simple_text":"إنك كنت بنا بصيرا"},{"sura_number":20,"ayah_number":36,"uthmani_text":"قالَ قَد أوتيتَ سُؤلَكَ يـٰموسىٰ","simple_text":"قال قد أوتيت سؤلك يا موسى"},{"sura_number":20,"ayah_number":37,"uthmani_text":"وَلَقَد مَنَنّا عَلَيكَ مَرَّةً أُخرىٰ","simple_text":"ولقد مننا عليك مرة أخرى"}]