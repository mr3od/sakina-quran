[{"sura_number":37,"ayah_number":103,"uthmani_text":"فَلَمّا أَسلَما وَتَلَّهُ لِلجَبينِ","simple_text":"فلما أسلما وتله للجبين"},{"sura_number":37,"ayah_number":104,"uthmani_text":"وَنـٰدَينـٰهُ أَن يـٰإِبرٰهيمُ","simple_text":"وناديناه أن يا إبراهيم"},{"sura_number":37,"ayah_number":105,"uthmani_text":"قَد صَدَّقتَ الرُّءيا ۚ إِنّا كَذٰلِكَ نَجزِى المُحسِنينَ","simple_text":"قد صدقت الرؤيا ۚ إنا كذلك نجزي المحسنين"},{"sura_number":37,"ayah_number":106,"uthmani_text":"إِنَّ هـٰذا لَهُوَ البَلـٰؤُا۟ المُبينُ","simple_text":"إن هذا لهو البلاء المبين"},{"sura_number":37,"ayah_number":107,"uthmani_text":"وَفَدَينـٰهُ بِذِبحٍ عَظيمٍ","simple_text":"وفديناه بذبح عظيم"},{"sura_number":37,"ayah_number":108,"uthmani_text":"وَتَرَكنا عَلَيهِ فِى الـٔاخِرينَ","simple_text":"وتركنا عليه في الآخرين"},{"sura_number":37,"ayah_number":109,"uthmani_text":"سَلـٰمٌ عَلىٰ إِبرٰهيمَ","simple_text":"سلام على إبراهيم"},{"sura_number":37,"ayah_number":110,"uthmani_text":"كَذٰلِكَ نَجزِى المُحسِنينَ","simple_text":"كذلك نجزي المحسنين"},{"sura_number":37,"ayah_number":111,"uthmani_text":"إِنَّهُ مِن عِبادِنَا المُؤمِنينَ","simple_text":"إنه من عبادنا المؤمنين"},{"sura_number":37,"ayah_number":112,"uthmani_text":"وَبَشَّرنـٰهُ بِإِسحـٰقَ نَبِيًّا مِنَ الصّـٰلِحينَ","simple_text":"وبشرناه بإسحاق نبيا من الصالحين"},{"sura_number":37,"ayah_number":113,"uthmani_text":"وَبـٰرَكنا عَلَيهِ وَعَلىٰ إِسحـٰقَ ۚ وَمِن ذُرِّيَّتِهِما مُحسِنٌ وَظالِمٌ لِنَفسِهِ مُبينٌ","simple_text":"وباركنا عليه وعلى إسحاق ۚ ومن ذريتهما محسن وظالم لنفسه مبين"},{"sura_number":37,"ayah_number":114,"uthmani_text":"وَلَقَد مَنَنّا عَلىٰ موسىٰ وَهـٰرونَ","simple_text":"ولقد مننا على موسى وهارون"},{"sura_number":37,"ayah_number":115,"uthmani_text":"وَنَجَّينـٰهُما وَقَومَهُما مِنَ الكَربِ العَظيمِ","simple_text":"ونجيناهما وقومهما من الكرب العظيم"},{"sura_number":37,"ayah_number":116,"uthmani_text":"وَنَصَرنـٰهُم فَكانوا هُمُ الغـٰلِبينَ","simple_text":"ونصرناهم فكانوا هم الغالبين"},{"sura_number":37,"ayah_number":117,"uthmani_text":"وَءاتَينـٰهُمَا الكِتـٰبَ المُستَبينَ","simple_text":"وآتيناهما الكتاب المستبين"},{"sura_number":37,"ayah_number":118,"uthmani_text":"وَهَدَينـٰهُمَا الصِّرٰطَ المُستَقيمَ","simple_text":"وهديناهما الصراط المستقيم"},{"sura_number":37,"ayah_number":119,"uthmani_text":"وَتَرَكنا عَلَيهِما فِى الـٔاخِرينَ","simple_text":"وتركنا عليهما في الآخرين"},{"sura_number":37,"ayah_number":120,"uthmani_text":"سَلـٰمٌ عَلىٰ موسىٰ وَهـٰرونَ","simple_text":"سلام على موسى وهارون"},{"sura_number":37,"ayah_number":121,"uthmani_text":"إِنّا كَذٰلِكَ نَجزِى المُحسِنينَ","simple_text":"إنا كذلك نجزي المحسنين"},{"sura_number":37,"ayah_number":122,"uthmani_text":"إِنَّهُما مِن عِبادِنَا المُؤمِنينَ","simple_text":"إنهما من عبادنا المؤمنين"},{"sura_number":37,"ayah_number":123,"uthmani_text":"وَإِنَّ إِلياسَ لَمِنَ المُرسَلينَ","simple_text":"وإن إلياس لمن المرسلين"},{"sura_number":37,"ayah_number":124,"uthmani_text":"إِذ قالَ لِقَومِهِ أَلا تَتَّقونَ","simple_text":"إذ قال لقومه ألا تتقون"},{"sura_number":37,"ayah_number":125,"uthmani_text":"أَتَدعونَ بَعلًا وَتَذَرونَ أَحسَنَ الخـٰلِقينَ","simple_text":"أتدعون بعلا وتذرون أحسن الخالقين"},{"sura_number":37,"ayah_number":126,"uthmani_text":"اللَّهَ رَبَّكُم وَرَبَّ ءابائِكُمُ الأَوَّلينَ","simple_text":"الله ربكم ورب آبائكم الأولين"}]