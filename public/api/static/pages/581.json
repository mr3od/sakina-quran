[{"sura_number":77,"ayah_number":20,"uthmani_text":"أَلَم نَخلُقكُم مِن ماءٍ مَهينٍ","simple_text":"ألم نخلقكم من ماء مهين"},{"sura_number":77,"ayah_number":21,"uthmani_text":"فَجَعَلنـٰهُ فى قَرارٍ مَكينٍ","simple_text":"فجعلناه في قرار مكين"},{"sura_number":77,"ayah_number":22,"uthmani_text":"إِلىٰ قَدَرٍ مَعلومٍ","simple_text":"إلى قدر معلوم"},{"sura_number":77,"ayah_number":23,"uthmani_text":"فَقَدَرنا فَنِعمَ القـٰدِرونَ","simple_text":"فقدرنا فنعم القادرون"},{"sura_number":77,"ayah_number":24,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":25,"uthmani_text":"أَلَم نَجعَلِ الأَرضَ كِفاتًا","simple_text":"ألم نجعل الأرض كفاتا"},{"sura_number":77,"ayah_number":26,"uthmani_text":"أَحياءً وَأَموٰتًا","simple_text":"أحياء وأمواتا"},{"sura_number":77,"ayah_number":27,"uthmani_text":"وَجَعَلنا فيها رَوٰسِىَ شـٰمِخـٰتٍ وَأَسقَينـٰكُم ماءً فُراتًا","simple_text":"وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا"},{"sura_number":77,"ayah_number":28,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":29,"uthmani_text":"انطَلِقوا إِلىٰ ما كُنتُم بِهِ تُكَذِّبونَ","simple_text":"انطلقوا إلى ما كنتم به تكذبون"},{"sura_number":77,"ayah_number":30,"uthmani_text":"انطَلِقوا إِلىٰ ظِلٍّ ذى ثَلـٰثِ شُعَبٍ","simple_text":"انطلقوا إلى ظل ذي ثلاث شعب"},{"sura_number":77,"ayah_number":31,"uthmani_text":"لا ظَليلٍ وَلا يُغنى مِنَ اللَّهَبِ","simple_text":"لا ظليل ولا يغني من اللهب"},{"sura_number":77,"ayah_number":32,"uthmani_text":"إِنَّها تَرمى بِشَرَرٍ كَالقَصرِ","simple_text":"إنها ترمي بشرر كالقصر"},{"sura_number":77,"ayah_number":33,"uthmani_text":"كَأَنَّهُ جِمـٰلَتٌ صُفرٌ","simple_text":"كأنه جمالت صفر"},{"sura_number":77,"ayah_number":34,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":35,"uthmani_text":"هـٰذا يَومُ لا يَنطِقونَ","simple_text":"هذا يوم لا ينطقون"},{"sura_number":77,"ayah_number":36,"uthmani_text":"وَلا يُؤذَنُ لَهُم فَيَعتَذِرونَ","simple_text":"ولا يؤذن لهم فيعتذرون"},{"sura_number":77,"ayah_number":37,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":38,"uthmani_text":"هـٰذا يَومُ الفَصلِ ۖ جَمَعنـٰكُم وَالأَوَّلينَ","simple_text":"هذا يوم الفصل ۖ جمعناكم والأولين"},{"sura_number":77,"ayah_number":39,"uthmani_text":"فَإِن كانَ لَكُم كَيدٌ فَكيدونِ","simple_text":"فإن كان لكم كيد فكيدون"},{"sura_number":77,"ayah_number":40,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":41,"uthmani_text":"إِنَّ المُتَّقينَ فى ظِلـٰلٍ وَعُيونٍ","simple_text":"إن المتقين في ظلال وعيون"},{"sura_number":77,"ayah_number":42,"uthmani_text":"وَفَوٰكِهَ مِمّا يَشتَهونَ","simple_text":"وفواكه مما يشتهون"},{"sura_number":77,"ayah_number":43,"uthmani_text":"كُلوا وَاشرَبوا هَنيـًٔا بِما كُنتُم تَعمَلونَ","simple_text":"كلوا واشربوا هنيئا بما كنتم تعملون"},{"sura_number":77,"ayah_number":44,"uthmani_text":"إِنّا كَذٰلِكَ نَجزِى المُحسِنينَ","simple_text":"إنا كذلك نجزي المحسنين"},{"sura_number":77,"ayah_number":45,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":46,"uthmani_text":"كُلوا وَتَمَتَّعوا قَليلًا إِنَّكُم مُجرِمونَ","simple_text":"كلوا وتمتعوا قليلا إنكم مجرمون"},{"sura_number":77,"ayah_number":47,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":48,"uthmani_text":"وَإِذا قيلَ لَهُمُ اركَعوا لا يَركَعونَ","simple_text":"وإذا قيل لهم اركعوا لا يركعون"},{"sura_number":77,"ayah_number":49,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":50,"uthmani_text":"فَبِأَىِّ حَديثٍ بَعدَهُ يُؤمِنونَ","simple_text":"فبأي حديث بعده يؤمنون"}]