[{"sura_number":37,"ayah_number":77,"uthmani_text":"وَجَعَلنا ذُرِّيَّتَهُ هُمُ الباقينَ","simple_text":"وجعلنا ذريته هم الباقين"},{"sura_number":37,"ayah_number":78,"uthmani_text":"وَتَرَكنا عَلَيهِ فِى الـٔاخِرينَ","simple_text":"وتركنا عليه في الآخرين"},{"sura_number":37,"ayah_number":79,"uthmani_text":"سَلـٰمٌ عَلىٰ نوحٍ فِى العـٰلَمينَ","simple_text":"سلام على نوح في العالمين"},{"sura_number":37,"ayah_number":80,"uthmani_text":"إِنّا كَذٰلِكَ نَجزِى المُحسِنينَ","simple_text":"إنا كذلك نجزي المحسنين"},{"sura_number":37,"ayah_number":81,"uthmani_text":"إِنَّهُ مِن عِبادِنَا المُؤمِنينَ","simple_text":"إنه من عبادنا المؤمنين"},{"sura_number":37,"ayah_number":82,"uthmani_text":"ثُمَّ أَغرَقنَا الـٔاخَرينَ","simple_text":"ثم أغرقنا الآخرين"},{"sura_number":37,"ayah_number":83,"uthmani_text":"۞ وَإِنَّ مِن شيعَتِهِ لَإِبرٰهيمَ","simple_text":"۞ وإن من شيعته لإبراهيم"},{"sura_number":37,"ayah_number":84,"uthmani_text":"إِذ جاءَ رَبَّهُ بِقَلبٍ سَليمٍ","simple_text":"إذ جاء ربه بقلب سليم"},{"sura_number":37,"ayah_number":85,"uthmani_text":"إِذ قالَ لِأَبيهِ وَقَومِهِ ماذا تَعبُدونَ","simple_text":"إذ قال لأبيه وقومه ماذا تعبدون"},{"sura_number":37,"ayah_number":86,"uthmani_text":"أَئِفكًا ءالِهَةً دونَ اللَّهِ تُريدونَ","simple_text":"أئفكا آلهة دون الله تريدون"},{"sura_number":37,"ayah_number":87,"uthmani_text":"فَما ظَنُّكُم بِرَبِّ العـٰلَمينَ","simple_text":"فما ظنكم برب العالمين"},{"sura_number":37,"ayah_number":88,"uthmani_text":"فَنَظَرَ نَظرَةً فِى النُّجومِ","simple_text":"فنظر نظرة في النجوم"},{"sura_number":37,"ayah_number":89,"uthmani_text":"فَقالَ إِنّى سَقيمٌ","simple_text":"فقال إني سقيم"},{"sura_number":37,"ayah_number":90,"uthmani_text":"فَتَوَلَّوا عَنهُ مُدبِرينَ","simple_text":"فتولوا عنه مدبرين"},{"sura_number":37,"ayah_number":91,"uthmani_text":"فَراغَ إِلىٰ ءالِهَتِهِم فَقالَ أَلا تَأكُلونَ","simple_text":"فراغ إلى آلهتهم فقال ألا تأكلون"},{"sura_number":37,"ayah_number":92,"uthmani_text":"ما لَكُم لا تَنطِقونَ","simple_text":"ما لكم لا تنطقون"},{"sura_number":37,"ayah_number":93,"uthmani_text":"فَراغَ عَلَيهِم ضَربًا بِاليَمينِ","simple_text":"فراغ عليهم ضربا باليمين"},{"sura_number":37,"ayah_number":94,"uthmani_text":"فَأَقبَلوا إِلَيهِ يَزِفّونَ","simple_text":"فأقبلوا إليه يزفون"},{"sura_number":37,"ayah_number":95,"uthmani_text":"قالَ أَتَعبُدونَ ما تَنحِتونَ","simple_text":"قال أتعبدون ما تنحتون"},{"sura_number":37,"ayah_number":96,"uthmani_text":"وَاللَّهُ خَلَقَكُم وَما تَعمَلونَ","simple_text":"والله خلقكم وما تعملون"},{"sura_number":37,"ayah_number":97,"uthmani_text":"قالُوا ابنوا لَهُ بُنيـٰنًا فَأَلقوهُ فِى الجَحيمِ","simple_text":"قالوا ابنوا له بنيانا فألقوه في الجحيم"},{"sura_number":37,"ayah_number":98,"uthmani_text":"فَأَرادوا بِهِ كَيدًا فَجَعَلنـٰهُمُ الأَسفَلينَ","simple_text":"فأرادوا به كيدا فجعلناهم الأسفلين"},{"sura_number":37,"ayah_number":99,"uthmani_text":"وَقالَ إِنّى ذاهِبٌ إِلىٰ رَبّى سَيَهدينِ","simple_text":"وقال إني ذاهب إلى ربي سيهدين"},{"sura_number":37,"ayah_number":100,"uthmani_text":"رَبِّ هَب لى مِنَ الصّـٰلِحينَ","simple_text":"رب هب لي من الصالحين"},{"sura_number":37,"ayah_number":101,"uthmani_text":"فَبَشَّرنـٰهُ بِغُلـٰمٍ حَليمٍ","simple_text":"فبشرناه بغلام حليم"},{"sura_number":37,"ayah_number":102,"uthmani_text":"فَلَمّا بَلَغَ مَعَهُ السَّعىَ قالَ يـٰبُنَىَّ إِنّى أَرىٰ فِى المَنامِ أَنّى أَذبَحُكَ فَانظُر ماذا تَرىٰ ۚ قالَ يـٰأَبَتِ افعَل ما تُؤمَرُ ۖ سَتَجِدُنى إِن شاءَ اللَّهُ مِنَ الصّـٰبِرينَ","simple_text":"فلما بلغ معه السعي قال يا بني إني أرى في المنام أني أذبحك فانظر ماذا ترى ۚ قال يا أبت افعل ما تؤمر ۖ ستجدني إن شاء الله من الصابرين"}]