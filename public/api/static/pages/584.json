[{"sura_number":79,"ayah_number":16,"uthmani_text":"إِذ نادىٰهُ رَبُّهُ بِالوادِ المُقَدَّسِ طُوًى","simple_text":"إذ ناداه ربه بالواد المقدس طوى"},{"sura_number":79,"ayah_number":17,"uthmani_text":"اذهَب إِلىٰ فِرعَونَ إِنَّهُ طَغىٰ","simple_text":"اذهب إلى فرعون إنه طغى"},{"sura_number":79,"ayah_number":18,"uthmani_text":"فَقُل هَل لَكَ إِلىٰ أَن تَزَكّىٰ","simple_text":"فقل هل لك إلى أن تزكى"},{"sura_number":79,"ayah_number":19,"uthmani_text":"وَأَهدِيَكَ إِلىٰ رَبِّكَ فَتَخشىٰ","simple_text":"وأهديك إلى ربك فتخشى"},{"sura_number":79,"ayah_number":20,"uthmani_text":"فَأَرىٰهُ الـٔايَةَ الكُبرىٰ","simple_text":"فأراه الآية الكبرى"},{"sura_number":79,"ayah_number":21,"uthmani_text":"فَكَذَّبَ وَعَصىٰ","simple_text":"فكذب وعصى"},{"sura_number":79,"ayah_number":22,"uthmani_text":"ثُمَّ أَدبَرَ يَسعىٰ","simple_text":"ثم أدبر يسعى"},{"sura_number":79,"ayah_number":23,"uthmani_text":"فَحَشَرَ فَنادىٰ","simple_text":"فحشر فنادى"},{"sura_number":79,"ayah_number":24,"uthmani_text":"فَقالَ أَنا۠ رَبُّكُمُ الأَعلىٰ","simple_text":"فقال أنا ربكم الأعلى"},{"sura_number":79,"ayah_number":25,"uthmani_text":"فَأَخَذَهُ اللَّهُ نَكالَ الـٔاخِرَةِ وَالأولىٰ","simple_text":"فأخذه الله نكال الآخرة والأولى"},{"sura_number":79,"ayah_number":26,"uthmani_text":"إِنَّ فى ذٰلِكَ لَعِبرَةً لِمَن يَخشىٰ","simple_text":"إن في ذلك لعبرة لمن يخشى"},{"sura_number":79,"ayah_number":27,"uthmani_text":"ءَأَنتُم أَشَدُّ خَلقًا أَمِ السَّماءُ ۚ بَنىٰها","simple_text":"أأنتم أشد خلقا أم السماء ۚ بناها"},{"sura_number":79,"ayah_number":28,"uthmani_text":"رَفَعَ سَمكَها فَسَوّىٰها","simple_text":"رفع سمكها فسواها"},{"sura_number":79,"ayah_number":29,"uthmani_text":"وَأَغطَشَ لَيلَها وَأَخرَجَ ضُحىٰها","simple_text":"وأغطش ليلها وأخرج ضحاها"},{"sura_number":79,"ayah_number":30,"uthmani_text":"وَالأَرضَ بَعدَ ذٰلِكَ دَحىٰها","simple_text":"والأرض بعد ذلك دحاها"},{"sura_number":79,"ayah_number":31,"uthmani_text":"أَخرَجَ مِنها ماءَها وَمَرعىٰها","simple_text":"أخرج منها ماءها ومرعاها"},{"sura_number":79,"ayah_number":32,"uthmani_text":"وَالجِبالَ أَرسىٰها","simple_text":"والجبال أرساها"},{"sura_number":79,"ayah_number":33,"uthmani_text":"مَتـٰعًا لَكُم وَلِأَنعـٰمِكُم","simple_text":"متاعا لكم ولأنعامكم"},{"sura_number":79,"ayah_number":34,"uthmani_text":"فَإِذا جاءَتِ الطّامَّةُ الكُبرىٰ","simple_text":"فإذا جاءت الطامة الكبرى"},{"sura_number":79,"ayah_number":35,"uthmani_text":"يَومَ يَتَذَكَّرُ الإِنسـٰنُ ما سَعىٰ","simple_text":"يوم يتذكر الإنسان ما سعى"},{"sura_number":79,"ayah_number":36,"uthmani_text":"وَبُرِّزَتِ الجَحيمُ لِمَن يَرىٰ","simple_text":"وبرزت الجحيم لمن يرى"},{"sura_number":79,"ayah_number":37,"uthmani_text":"فَأَمّا مَن طَغىٰ","simple_text":"فأما من طغى"},{"sura_number":79,"ayah_number":38,"uthmani_text":"وَءاثَرَ الحَيوٰةَ الدُّنيا","simple_text":"وآثر الحياة الدنيا"},{"sura_number":79,"ayah_number":39,"uthmani_text":"فَإِنَّ الجَحيمَ هِىَ المَأوىٰ","simple_text":"فإن الجحيم هي المأوى"},{"sura_number":79,"ayah_number":40,"uthmani_text":"وَأَمّا مَن خافَ مَقامَ رَبِّهِ وَنَهَى النَّفسَ عَنِ الهَوىٰ","simple_text":"وأما من خاف مقام ربه ونهى النفس عن الهوى"},{"sura_number":79,"ayah_number":41,"uthmani_text":"فَإِنَّ الجَنَّةَ هِىَ المَأوىٰ","simple_text":"فإن الجنة هي المأوى"},{"sura_number":79,"ayah_number":42,"uthmani_text":"يَسـَٔلونَكَ عَنِ السّاعَةِ أَيّانَ مُرسىٰها","simple_text":"يسألونك عن الساعة أيان مرساها"},{"sura_number":79,"ayah_number":43,"uthmani_text":"فيمَ أَنتَ مِن ذِكرىٰها","simple_text":"فيم أنت من ذكراها"},{"sura_number":79,"ayah_number":44,"uthmani_text":"إِلىٰ رَبِّكَ مُنتَهىٰها","simple_text":"إلى ربك منتهاها"},{"sura_number":79,"ayah_number":45,"uthmani_text":"إِنَّما أَنتَ مُنذِرُ مَن يَخشىٰها","simple_text":"إنما أنت منذر من يخشاها"},{"sura_number":79,"ayah_number":46,"uthmani_text":"كَأَنَّهُم يَومَ يَرَونَها لَم يَلبَثوا إِلّا عَشِيَّةً أَو ضُحىٰها","simple_text":"كأنهم يوم يرونها لم يلبثوا إلا عشية أو ضحاها"}]