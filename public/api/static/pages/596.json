[{"sura_number":92,"ayah_number":15,"uthmani_text":"لا يَصلىٰها إِلَّا الأَشقَى","simple_text":"لا يصلاها إلا الأشقى"},{"sura_number":92,"ayah_number":16,"uthmani_text":"الَّذى كَذَّبَ وَتَوَلّىٰ","simple_text":"الذي كذب وتولى"},{"sura_number":92,"ayah_number":17,"uthmani_text":"وَسَيُجَنَّبُهَا الأَتقَى","simple_text":"وسيجنبها الأتقى"},{"sura_number":92,"ayah_number":18,"uthmani_text":"الَّذى يُؤتى مالَهُ يَتَزَكّىٰ","simple_text":"الذي يؤتي ماله يتزكى"},{"sura_number":92,"ayah_number":19,"uthmani_text":"وَما لِأَحَدٍ عِندَهُ مِن نِعمَةٍ تُجزىٰ","simple_text":"وما لأحد عنده من نعمة تجزى"},{"sura_number":92,"ayah_number":20,"uthmani_text":"إِلَّا ابتِغاءَ وَجهِ رَبِّهِ الأَعلىٰ","simple_text":"إلا ابتغاء وجه ربه الأعلى"},{"sura_number":92,"ayah_number":21,"uthmani_text":"وَلَسَوفَ يَرضىٰ","simple_text":"ولسوف يرضى"},{"sura_number":93,"ayah_number":1,"uthmani_text":"وَالضُّحىٰ","simple_text":"والضحى"},{"sura_number":93,"ayah_number":2,"uthmani_text":"وَالَّيلِ إِذا سَجىٰ","simple_text":"والليل إذا سجى"},{"sura_number":93,"ayah_number":3,"uthmani_text":"ما وَدَّعَكَ رَبُّكَ وَما قَلىٰ","simple_text":"ما ودعك ربك وما قلى"},{"sura_number":93,"ayah_number":4,"uthmani_text":"وَلَلـٔاخِرَةُ خَيرٌ لَكَ مِنَ الأولىٰ","simple_text":"وللآخرة خير لك من الأولى"},{"sura_number":93,"ayah_number":5,"uthmani_text":"وَلَسَوفَ يُعطيكَ رَبُّكَ فَتَرضىٰ","simple_text":"ولسوف يعطيك ربك فترضى"},{"sura_number":93,"ayah_number":6,"uthmani_text":"أَلَم يَجِدكَ يَتيمًا فَـٔاوىٰ","simple_text":"ألم يجدك يتيما فآوى"},{"sura_number":93,"ayah_number":7,"uthmani_text":"وَوَجَدَكَ ضالًّا فَهَدىٰ","simple_text":"ووجدك ضالا فهدى"},{"sura_number":93,"ayah_number":8,"uthmani_text":"وَوَجَدَكَ عائِلًا فَأَغنىٰ","simple_text":"ووجدك عائلا فأغنى"},{"sura_number":93,"ayah_number":9,"uthmani_text":"فَأَمَّا اليَتيمَ فَلا تَقهَر","simple_text":"فأما اليتيم فلا تقهر"},{"sura_number":93,"ayah_number":10,"uthmani_text":"وَأَمَّا السّائِلَ فَلا تَنهَر","simple_text":"وأما السائل فلا تنهر"},{"sura_number":93,"ay