[{"sura_number":76,"ayah_number":26,"uthmani_text":"وَمِنَ الَّيلِ فَاسجُد لَهُ وَسَبِّحهُ لَيلًا طَويلًا","simple_text":"ومن الليل فاسجد له وسبحه ليلا طويلا"},{"sura_number":76,"ayah_number":27,"uthmani_text":"إِنَّ هـٰؤُلاءِ يُحِبّونَ العاجِلَةَ وَيَذَرونَ وَراءَهُم يَومًا ثَقيلًا","simple_text":"إن هؤلاء يحبون العاجلة ويذرون وراءهم يوما ثقيلا"},{"sura_number":76,"ayah_number":28,"uthmani_text":"نَحنُ خَلَقنـٰهُم وَشَدَدنا أَسرَهُم ۖ وَإِذا شِئنا بَدَّلنا أَمثـٰلَهُم تَبديلًا","simple_text":"نحن خلقناهم وشددنا أسرهم ۖ وإذا شئنا بدلنا أمثالهم تبديلا"},{"sura_number":76,"ayah_number":29,"uthmani_text":"إِنَّ هـٰذِهِ تَذكِرَةٌ ۖ فَمَن شاءَ اتَّخَذَ إِلىٰ رَبِّهِ سَبيلًا","simple_text":"إن هذه تذكرة ۖ فمن شاء اتخذ إلى ربه سبيلا"},{"sura_number":76,"ayah_number":30,"uthmani_text":"وَما تَشاءونَ إِلّا أَن يَشاءَ اللَّهُ ۚ إِنَّ اللَّهَ كانَ عَليمًا حَكيمًا","simple_text":"وما تشاءون إلا أن يشاء الله ۚ إن الله كان عليما حكيما"},{"sura_number":76,"ayah_number":31,"uthmani_text":"يُدخِلُ مَن يَشاءُ فى رَحمَتِهِ ۚ وَالظّـٰلِمينَ أَعَدَّ لَهُم عَذابًا أَليمًا","simple_text":"يدخل من يشاء في رحمته ۚ والظالمين أعد لهم عذابا أليما"},{"sura_number":77,"ayah_number":1,"uthmani_text":"وَالمُرسَلـٰتِ عُرفًا","simple_text":"والمرسلات عرفا"},{"sura_number":77,"ayah_number":2,"uthmani_text":"فَالعـٰصِفـٰتِ عَصفًا","simple_text":"فالعاصفات عصفا"},{"sura_number":77,"ayah_number":3,"uthmani_text":"وَالنّـٰشِرٰتِ نَشرًا","simple_text":"والناشرات نشرا"},{"sura_number":77,"ayah_number":4,"uthmani_text":"فَالفـٰرِقـٰتِ فَرقًا","simple_text":"فالفارقات فرقا"},{"sura_number":77,"ayah_number":5,"uthmani_text":"فَالمُلقِيـٰتِ ذِكرًا","simple_text":"فالملقيات ذكرا"},{"sura_number":77,"ayah_number":6,"uthmani_text":"عُذرًا أَو نُذرًا","simple_text":"عذرا أو نذرا"},{"sura_number":77,"ayah_number":7,"uthmani_text":"إِنَّما توعَدونَ لَوٰقِعٌ","simple_text":"إنما توعدون لواقع"},{"sura_number":77,"ayah_number":8,"uthmani_text":"فَإِذَا النُّجومُ طُمِسَت","simple_text":"فإذا النجوم طمست"},{"sura_number":77,"ayah_number":9,"uthmani_text":"وَإِذَا السَّماءُ فُرِجَت","simple_text":"وإذا السماء فرجت"},{"sura_number":77,"ayah_number":10,"uthmani_text":"وَإِذَا الجِبالُ نُسِفَت","simple_text":"وإذا الجبال نسفت"},{"sura_number":77,"ayah_number":11,"uthmani_text":"وَإِذَا الرُّسُلُ أُقِّتَت","simple_text":"وإذا الرسل أقتت"},{"sura_number":77,"ayah_number":12,"uthmani_text":"لِأَىِّ يَومٍ أُجِّلَت","simple_text":"لأي يوم أجلت"},{"sura_number":77,"ayah_number":13,"uthmani_text":"لِيَومِ الفَصلِ","simple_text":"ليوم الفصل"},{"sura_number":77,"ayah_number":14,"uthmani_text":"وَما أَدرىٰكَ ما يَومُ الفَصلِ","simple_text":"وما أدراك ما يوم الفصل"},{"sura_number":77,"ayah_number":15,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"},{"sura_number":77,"ayah_number":16,"uthmani_text":"أَلَم نُهلِكِ الأَوَّلينَ","simple_text":"ألم نهلك الأولين"},{"sura_number":77,"ayah_number":17,"uthmani_text":"ثُمَّ نُتبِعُهُمُ الـٔاخِرينَ","simple_text":"ثم نتبعهم الآخرين"},{"sura_number":77,"ayah_number":18,"uthmani_text":"كَذٰلِكَ نَفعَلُ بِالمُجرِمينَ","simple_text":"كذلك نفعل بالمجرمين"},{"sura_number":77,"ayah_number":19,"uthmani_text":"وَيلٌ يَومَئِذٍ لِلمُكَذِّبينَ","simple_text":"ويل يومئذ للمكذبين"}]