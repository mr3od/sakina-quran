[{"sura_number":53,"ayah_number":1,"uthmani_text":"وَالنَّجمِ إِذا هَوىٰ","simple_text":"والنجم إذا هوى"},{"sura_number":53,"ayah_number":2,"uthmani_text":"ما ضَلَّ صاحِبُكُم وَما غَوىٰ","simple_text":"ما ضل صاحبكم وما غوى"},{"sura_number":53,"ayah_number":3,"uthmani_text":"وَما يَنطِقُ عَنِ الهَوىٰ","simple_text":"وما ينطق عن الهوى"},{"sura_number":53,"ayah_number":4,"uthmani_text":"إِن هُوَ إِلّا وَحىٌ يوحىٰ","simple_text":"إن هو إلا وحي يوحى"},{"sura_number":53,"ayah_number":5,"uthmani_text":"عَلَّمَهُ شَديدُ القُوىٰ","simple_text":"علمه شديد القوى"},{"sura_number":53,"ayah_number":6,"uthmani_text":"ذو مِرَّةٍ فَاستَوىٰ","simple_text":"ذو مرة فاستوى"},{"sura_number":53,"ayah_number":7,"uthmani_text":"وَهُوَ بِالأُفُقِ الأَعلىٰ","simple_text":"وهو بالأفق الأعلى"},{"sura_number":53,"ayah_number":8,"uthmani_text":"ثُمَّ دَنا فَتَدَلّىٰ","simple_text":"ثم دنا فتدلى"},{"sura_number":53,"ayah_number":9,"uthmani_text":"فَكانَ قابَ قَوسَينِ أَو أَدنىٰ","simple_text":"فكان قاب قوسين أو أدنى"},{"sura_number":53,"ayah_number":10,"uthmani_text":"فَأَوحىٰ إِلىٰ عَبدِهِ ما أَوحىٰ","simple_text":"فأوحى إلى عبده ما أوحى"},{"sura_number":53,"ayah_number":11,"uthmani_text":"ما كَذَبَ الفُؤادُ ما رَأىٰ","simple_text":"ما كذب الفؤاد ما رأى"},{"sura_number":53,"ayah_number":12,"uthmani_text":"أَفَتُمـٰرونَهُ عَلىٰ ما يَرىٰ","simple_text":"أفتمارونه على ما يرى"},{"sura_number":53,"ayah_number":13,"uthmani_text":"وَلَقَد رَءاهُ نَزلَةً أُخرىٰ","simple_text":"ولقد رآه نزلة أخرى"},{"sura_number":53,"ayah_number":14,"uthmani_text":"عِندَ سِدرَةِ المُنتَهىٰ","simple_text":"عند سدرة المنتهى"},{"sura_number":53,"ayah_number":15,"uthmani_text":"عِندَها جَنَّةُ المَأوىٰ","simple_text":"عندها جنة المأوى"},{"sura_number":53,"ayah_number":16,"uthmani_text":"إِذ يَغشَى السِّدرَةَ ما يَغشىٰ","simple_text":"إذ يغشى السدرة ما يغشى"},{"sura_number":53,"ayah_number":17,"uthmani_text":"ما زاغَ البَصَرُ وَما طَغىٰ","simple_text":"ما زاغ البصر وما طغى"},{"sura_number":53,"ayah_number":18,"uthmani_text":"لَقَد رَأىٰ مِن ءايـٰتِ رَبِّهِ الكُبرىٰ","simple_text":"لقد رأى من آيات ربه الكبرى"},{"sura_number":53,"ayah_number":19,"uthmani_text":"أَفَرَءَيتُمُ اللّـٰتَ وَالعُزّىٰ","simple_text":"أفرأيتم اللات والعزى"},{"sura_number":53,"ayah_number":20,"uthmani_text":"وَمَنوٰةَ الثّالِثَةَ الأُخرىٰ","simple_text":"ومناة الثالثة الأخرى"},{"sura_number":53,"ayah_number":21,"uthmani_text":"أَلَكُمُ الذَّكَرُ وَلَهُ الأُنثىٰ","simple_text":"ألكم الذكر وله الأنثى"},{"sura_number":53,"ayah_number":22,"uthmani_text":"تِلكَ إِذًا قِسمَةٌ ضيزىٰ","simple_text":"تلك إذا قسمة ضيزى"},{"sura_number":53,"ayah_number":23,"uthmani_text":"إِن هِىَ إِلّا أَسماءٌ سَمَّيتُموها أَنتُم وَءاباؤُكُم ما أَنزَلَ اللَّهُ بِها مِن سُلطـٰنٍ ۚ إِن يَتَّبِعونَ إِلَّا الظَّنَّ وَما تَهوَى الأَنفُسُ ۖ وَلَقَد جاءَهُم مِن رَبِّهِمُ الهُدىٰ","simple_text":"إن هي إلا أسماء سميتموها أنتم وآباؤكم ما أنزل الله بها من سلطان ۚ إن يتبعون إلا الظن وما تهوى الأنفس ۖ ولقد جاءهم من ربهم الهدى"},{"sura_number":53,"ayah_number":24,"uthmani_text":"أَم لِلإِنسـٰنِ ما تَمَنّىٰ","simple_text":"أم للإنسان ما تمنى"},{"sura_number":53,"ayah_number":25,"uthmani_text":"فَلِلَّهِ الـٔاخِرَةُ وَالأولىٰ","simple_text":"فلله الآخرة والأولى"},{"sura_number":53,"ayah_number":26,"uthmani_text":"۞ وَكَم مِن مَلَكٍ فِى السَّمـٰوٰتِ لا تُغنى شَفـٰعَتُهُم شَيـًٔا إِلّا مِن بَعدِ أَن يَأذَنَ اللَّهُ لِمَن يَشاءُ وَيَرضىٰ","simple_text":"۞ وكم من ملك في السماوات لا تغني شفاعتهم شيئا إلا من بعد أن يأذن الله لمن يشاء ويرضى"}]