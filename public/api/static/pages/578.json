[{"sura_number":75,"ayah_number":20,"uthmani_text":"كَلّا بَل تُحِبّونَ العاجِلَةَ","simple_text":"كلا بل تحبون العاجلة"},{"sura_number":75,"ayah_number":21,"uthmani_text":"وَتَذَرونَ الـٔاخِرَةَ","simple_text":"وتذرون الآخرة"},{"sura_number":75,"ayah_number":22,"uthmani_text":"وُجوهٌ يَومَئِذٍ ناضِرَةٌ","simple_text":"وجوه يومئذ ناضرة"},{"sura_number":75,"ayah_number":23,"uthmani_text":"إِلىٰ رَبِّها ناظِرَةٌ","simple_text":"إلى ربها ناظرة"},{"sura_number":75,"ayah_number":24,"uthmani_text":"وَوُجوهٌ يَومَئِذٍ باسِرَةٌ","simple_text":"ووجوه يومئذ باسرة"},{"sura_number":75,"ayah_number":25,"uthmani_text":"تَظُنُّ أَن يُفعَلَ بِها فاقِرَةٌ","simple_text":"تظن أن يفعل بها فاقرة"},{"sura_number":75,"ayah_number":26,"uthmani_text":"كَلّا إِذا بَلَغَتِ التَّراقِىَ","simple_text":"كلا إذا بلغت التراقي"},{"sura_number":75,"ayah_number":27,"uthmani_text":"وَقيلَ مَن ۜ راقٍ","simple_text":"وقيل من ۜ راق"},{"sura_number":75,"ayah_number":28,"uthmani_text":"وَظَنَّ أَنَّهُ الفِراقُ","simple_text":"وظن أنه الفراق"},{"sura_number":75,"ayah_number":29,"uthmani_text":"وَالتَفَّتِ السّاقُ بِالسّاقِ","simple_text":"والتفت الساق بالساق"},{"sura_number":75,"ayah_number":30,"uthmani_text":"إِلىٰ رَبِّكَ يَومَئِذٍ المَساقُ","simple_text":"إلى ربك يومئذ المساق"},{"sura_number":75,"ayah_number":31,"uthmani_text":"فَلا صَدَّقَ وَلا صَلّىٰ","simple_text":"فلا صدق ولا صلى"},{"sura_number":75,"ayah_number":32,"uthmani_text":"وَلـٰكِن كَذَّبَ وَتَوَلّىٰ","simple_text":"ولكن كذب وتولى"},{"sura_number":75,"ayah_number":33,"uthmani_text":"ثُمَّ ذَهَبَ إِلىٰ أَهلِهِ يَتَمَطّىٰ","simple_text":"ثم ذهب إلى أهله يتمطى"},{"sura_number":75,"ayah_number":34,"uthmani_text":"أَولىٰ لَكَ فَأَولىٰ","simple_text":"أولى لك فأولى"},{"sura_number":75,"ayah_number":35,"uthmani_text":"ثُمَّ أَولىٰ لَكَ فَأَولىٰ","simple_text":"ثم أولى لك فأولى"},{"sura_number":75,"ayah_number":36,"uthmani_text":"أَيَحسَبُ الإِنسـٰنُ أَن يُترَكَ سُدًى","simple_text":"أيحسب الإنسان أن يترك سدى"},{"sura_number":75,"ayah_number":37,"uthmani_text":"أَلَم يَكُ نُطفَةً مِن مَنِىٍّ يُمنىٰ","simple_text":"ألم يك نطفة من مني يمنى"},{"sura_number":75,"ayah_number":38,"uthmani_text":"ثُمَّ كانَ عَلَقَةً فَخَلَقَ فَسَوّىٰ","simple_text":"ثم كان علقة فخلق فسوى"},{"sura_number":75,"ayah_number":39,"uthmani_text":"فَجَعَلَ مِنهُ الزَّوجَينِ الذَّكَرَ وَالأُنثىٰ","simple_text":"فجعل منه الزوجين الذكر والأنثى"},{"sura_number":75,"ayah_number":40,"uthmani_text":"أَلَيسَ ذٰلِكَ بِقـٰدِرٍ عَلىٰ أَن يُحـِۧىَ المَوتىٰ","simple_text":"أليس ذلك بقادر على أن يحيي الموتى"},{"sura_number":76,"ayah_number":1,"uthmani_text":"هَل أَتىٰ عَلَى الإِنسـٰنِ حينٌ مِنَ الدَّهرِ لَم يَكُن شَيـًٔا مَذكورًا","simple_text":"هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا"},{"sura_number":76,"ayah_number":2,"uthmani_text":"إِنّا خَلَقنَا الإِنسـٰنَ مِن نُطفَةٍ أَمشاجٍ نَبتَليهِ فَجَعَلنـٰهُ سَميعًا بَصيرًا","simple_text":"إنا خلقنا الإنسان من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا"},{"sura_number":76,"ayah_number":3,"uthmani_text":"إِنّا هَدَينـٰهُ السَّبيلَ إِمّا شاكِرًا وَإِمّا كَفورًا","simple_text":"إنا هديناه السبيل إما شاكرا وإما كفورا"},{"sura_number":76,"ayah_number":4,"uthmani_text":"إِنّا أَعتَدنا لِلكـٰفِرينَ سَلـٰسِلَا۟ وَأَغلـٰلًا وَسَعيرًا","simple_text":"إنا أعتدنا للكافرين سلاسل وأغلالا وسعيرا"},{"sura_number":76,"ayah_number":5,"uthmani_text":"إِنَّ الأَبرارَ يَشرَبونَ مِن كَأسٍ كانَ مِزاجُها كافورًا","simple_text":"إن الأبرار يشربون من كأس كان مزاجها كافورا"}]