[{"sura_number":56,"ayah_number":51,"uthmani_text":"ثُمَّ إِنَّكُم أَيُّهَا الضّالّونَ المُكَذِّبونَ","simple_text":"ثم إنكم أيها الضالون المكذبون"},{"sura_number":56,"ayah_number":52,"uthmani_text":"لَـٔاكِلونَ مِن شَجَرٍ مِن زَقّومٍ","simple_text":"لآكلون من شجر من زقوم"},{"sura_number":56,"ayah_number":53,"uthmani_text":"فَمالِـٔونَ مِنهَا البُطونَ","simple_text":"فمالئون منها البطون"},{"sura_number":56,"ayah_number":54,"uthmani_text":"فَشـٰرِبونَ عَلَيهِ مِنَ الحَميمِ","simple_text":"فشاربون عليه من الحميم"},{"sura_number":56,"ayah_number":55,"uthmani_text":"فَشـٰرِبونَ شُربَ الهيمِ","simple_text":"فشاربون شرب الهيم"},{"sura_number":56,"ayah_number":56,"uthmani_text":"هـٰذا نُزُلُهُم يَومَ الدّينِ","simple_text":"هذا نزلهم يوم الدين"},{"sura_number":56,"ayah_number":57,"uthmani_text":"نَحنُ خَلَقنـٰكُم فَلَولا تُصَدِّقونَ","simple_text":"نحن خلقناكم فلولا تصدقون"},{"sura_number":56,"ayah_number":58,"uthmani_text":"أَفَرَءَيتُم ما تُمنونَ","simple_text":"أفرأيتم ما تمنون"},{"sura_number":56,"ayah_number":59,"uthmani_text":"ءَأَنتُم تَخلُقونَهُ أَم نَحنُ الخـٰلِقونَ","simple_text":"أأنتم تخلقونه أم نحن الخالقون"},{"sura_number":56,"ayah_number":60,"uthmani_text":"نَحنُ قَدَّرنا بَينَكُمُ المَوتَ وَما نَحنُ بِمَسبوقينَ","simple_text":"نحن قدرنا بينكم الموت وما نحن بمسبوقين"},{"sura_number":56,"ayah_number":61,"uthmani_text":"عَلىٰ أَن نُبَدِّلَ أَمثـٰلَكُم وَنُنشِئَكُم فى ما لا تَعلَمونَ","simple_text":"على أن نبدل أمثالكم وننشئكم في ما لا تعلمون"},{"sura_number":56,"ayah_number":62,"uthmani_text":"وَلَقَد عَلِمتُمُ النَّشأَةَ الأولىٰ فَلَولا تَذَكَّرونَ","simple_text":"ولقد علمتم النشأة الأولى فلولا تذكرون"},{"sura_number":56,"ayah_number":63,"uthmani_text":"أَفَرَءَيتُم ما تَحرُثونَ","simple_text":"أفرأيتم ما تحرثون"},{"sura_number":56,"ayah_number":64,"uthmani_text":"ءَأَنتُم تَزرَعونَهُ أَم نَحنُ الزّٰرِعونَ","simple_text":"أأنتم تزرعونه أم نحن الزارعون"},{"sura_number":56,"ayah_number":65,"uthmani_text":"لَو نَشاءُ لَجَعَلنـٰهُ حُطـٰمًا فَظَلتُم تَفَكَّهونَ","simple_text":"لو نشاء لجعلناه حطاما فظلتم تفكهون"},{"sura_number":56,"ayah_number":66,"uthmani_text":"إِنّا لَمُغرَمونَ","simple_text":"إنا لمغرمون"},{"sura_number":56,"ayah_number":67,"uthmani_text":"بَل نَحنُ مَحرومونَ","simple_text":"بل نحن محرومون"},{"sura_number":56,"ayah_number":68,"uthmani_text":"أَفَرَءَيتُمُ الماءَ الَّذى تَشرَبونَ","simple_text":"أفرأيتم الماء الذي تشربون"},{"sura_number":56,"ayah_number":69,"uthmani_text":"ءَأَنتُم أَنزَلتُموهُ مِنَ المُزنِ أَم نَحنُ المُنزِلونَ","simple_text":"أأنتم أنزلتموه من المزن أم نحن المنزلون"},{"sura_number":56,"ayah_number":70,"uthmani_text":"لَو نَشاءُ جَعَلنـٰهُ أُجاجًا فَلَولا تَشكُرونَ","simple_text":"لو نشاء جعلناه أجاجا فلولا تشكرون"},{"sura_number":56,"ayah_number":71,"uthmani_text":"أَفَرَءَيتُمُ النّارَ الَّتى تورونَ","simple_text":"أفرأيتم النار التي تورون"},{"sura_number":56,"ayah_number":72,"uthmani_text":"ءَأَنتُم أَنشَأتُم شَجَرَتَها أَم نَحنُ المُنشِـٔونَ","simple_text":"أأنتم أنشأتم شجرتها أم نحن المنشئون"},{"sura_number":56,"ayah_number":73,"uthmani_text":"نَحنُ جَعَلنـٰها تَذكِرَةً وَمَتـٰعًا لِلمُقوينَ","simple_text":"نحن جعلناها تذكرة ومتاعا للمقوين"},{"sura_number":56,"ayah_number":74,"uthmani_text":"فَسَبِّح بِاسمِ رَبِّكَ العَظيمِ","simple_text":"فسبح باسم ربك العظيم"},{"sura_number":56,"ayah_number":75,"uthmani_text":"۞ فَلا أُقسِمُ بِمَوٰقِعِ النُّجومِ","simple_text":"۞ فلا أقسم بمواقع النجوم"},{"sura_number":56,"ayah_number":76,"uthmani_text":"وَإِنَّهُ لَقَسَمٌ لَو تَعلَمونَ عَظيمٌ","simple_text":"وإنه لقسم لو تعلمون عظيم"}]