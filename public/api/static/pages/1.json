[{"sura_number":1,"ayah_number":1,"uthmani_text":"بِسمِ اللَّهِ الرَّحمـٰنِ الرَّحيمِ","simple_text":"بسم الله الرحمن الرحيم"},{"sura_number":1,"ayah_number":2,"uthmani_text":"الحَمدُ لِلَّهِ رَبِّ العـٰلَمينَ","simple_text":"الحمد لله رب العالمين"},{"sura_number":1,"ayah_number":3,"uthmani_text":"الرَّحمـٰنِ الرَّحيمِ","simple_text":"الرحمن الرحيم"},{"sura_number":1,"ayah_number":4,"uthmani_text":"مـٰلِكِ يَومِ الدّينِ","simple_text":"مالك يوم الدين"},{"sura_number":1,"ayah_number":5,"uthmani_text":"إِيّاكَ نَعبُدُ وَإِيّاكَ نَستَعينُ","simple_text":"إياك نعبد وإياك نستعين"},{"sura_number":1,"ayah_number":6,"uthmani_text":"اهدِنَا الصِّرٰطَ المُستَقيمَ","simple_text":"اهدنا الصراط المستقيم"},{"sura_number":1,"ayah_number":7,"uthmani_text":"صِرٰطَ الَّذينَ أَنعَمتَ عَلَيهِم غَيرِ المَغضوبِ عَلَيهِم وَلَا الضّالّينَ","simple_text":"صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"}]