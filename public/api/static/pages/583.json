[{"sura_number":78,"ayah_number":31,"uthmani_text":"إِنَّ لِلمُتَّقينَ مَفازًا","simple_text":"إن للمتقين مفازا"},{"sura_number":78,"ayah_number":32,"uthmani_text":"حَدائِقَ وَأَعنـٰبًا","simple_text":"حدائق وأعنابا"},{"sura_number":78,"ayah_number":33,"uthmani_text":"وَكَواعِبَ أَترابًا","simple_text":"وكواعب أترابا"},{"sura_number":78,"ayah_number":34,"uthmani_text":"وَكَأسًا دِهاقًا","simple_text":"وكأسا دهاقا"},{"sura_number":78,"ayah_number":35,"uthmani_text":"لا يَسمَعونَ فيها لَغوًا وَلا كِذّٰبًا","simple_text":"لا يسمعون فيها لغوا ولا كذابا"},{"sura_number":78,"ayah_number":36,"uthmani_text":"جَزاءً مِن رَبِّكَ عَطاءً حِسابًا","simple_text":"جزاء من ربك عطاء حسابا"},{"sura_number":78,"ayah_number":37,"uthmani_text":"رَبِّ السَّمـٰوٰتِ وَالأَرضِ وَما بَينَهُمَا الرَّحمـٰنِ ۖ لا يَملِكونَ مِنهُ خِطابًا","simple_text":"رب السماوات والأرض وما بينهما الرحمن ۖ لا يملكون منه خطابا"},{"sura_number":78,"ayah_number":38,"uthmani_text":"يَومَ يَقومُ الرّوحُ وَالمَلـٰئِكَةُ صَفًّا ۖ لا يَتَكَلَّمونَ إِلّا مَن أَذِنَ لَهُ الرَّحمـٰنُ وَقالَ صَوابًا","simple_text":"يوم يقوم الروح والملائكة صفا ۖ لا يتكلمون إلا من أذن له الرحمن وقال صوابا"},{"sura_number":78,"ayah_number":39,"uthmani_text":"ذٰلِكَ اليَومُ الحَقُّ ۖ فَمَن شاءَ اتَّخَذَ إِلىٰ رَبِّهِ مَـٔابًا","simple_text":"ذلك اليوم الحق ۖ فمن شاء اتخذ إلى ربه مآبا"},{"sura_number":78,"ayah_number":40,"uthmani_text":"إِنّا أَنذَرنـٰكُم عَذابًا قَريبًا يَومَ يَنظُرُ المَرءُ ما قَدَّمَت يَداهُ وَيَقولُ الكافِرُ يـٰلَيتَنى كُنتُ تُرٰبًا","simple_text":"إنا أنذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"},{"sura_number":79,"ayah_number":1,"uthmani_text":"وَالنّـٰزِعـٰتِ غَرقًا","simple_text":"والنازعات غرقا"},{"sura_number":79,"ayah_number":2,"uthmani_text":"وَالنّـٰشِطـٰتِ نَشطًا","simple_text":"والناشطات نشطا"},{"sura_number":79,"ayah_number":3,"uthmani_text":"وَالسّـٰبِحـٰتِ سَبحًا","simple_text":"والسابحات سبحا"},{"sura_number":79,"ayah_number":4,"uthmani_text":"فَالسّـٰبِقـٰتِ سَبقًا","simple_text":"فالسابقات سبقا"},{"sura_number":79,"ayah_number":5,"uthmani_text":"فَالمُدَبِّرٰتِ أَمرًا","simple_text":"فالمدبرات أمرا"},{"sura_number":79,"ayah_number":6,"uthmani_text":"يَومَ تَرجُفُ الرّاجِفَةُ","simple_text":"يوم ترجف الراجفة"},{"sura_number":79,"ayah_number":7,"uthmani_text":"تَتبَعُهَا الرّادِفَةُ","simple_text":"تتبعها الرادفة"},{"sura_number":79,"ayah_number":8,"uthmani_text":"قُلوبٌ يَومَئِذٍ واجِفَةٌ","simple_text":"قلوب يومئذ واجفة"},{"sura_number":79,"ayah_number":9,"uthmani_text":"أَبصـٰرُها خـٰشِعَةٌ","simple_text":"أبصارها خاشعة"},{"sura_number":79,"ayah_number":10,"uthmani_text":"يَقولونَ أَءِنّا لَمَردودونَ فِى الحافِرَةِ","simple_text":"يقولون أإنا لمردودون في الحافرة"},{"sura_number":79,"ayah_number":11,"uthmani_text":"أَءِذا كُنّا عِظـٰمًا نَخِرَةً","simple_text":"أإذا كنا عظاما نخرة"},{"sura_number":79,"ayah_number":12,"uthmani_text":"قالوا تِلكَ إِذًا كَرَّةٌ خاسِرَةٌ","simple_text":"قالوا تلك إذا كرة خاسرة"},{"sura_number":79,"ayah_number":13,"uthmani_text":"فَإِنَّما هِىَ زَجرَةٌ وٰحِدَةٌ","simple_text":"فإنما هي زجرة واحدة"},{"sura_number":79,"ayah_number":14,"uthmani_text":"فَإِذا هُم بِالسّاهِرَةِ","simple_text":"فإذا هم بالساهرة"},{"sura_number":79,"ayah_number":15,"uthmani_text":"هَل أَتىٰكَ حَديثُ موسىٰ","simple_text":"هل أتاك حديث موسى"}]