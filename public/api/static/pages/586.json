[{"sura_number":81,"ayah_number":1,"uthmani_text":"إِذَا الشَّمسُ كُوِّرَت","simple_text":"إذا الشمس كورت"},{"sura_number":81,"ayah_number":2,"uthmani_text":"وَإِذَا النُّجومُ انكَدَرَت","simple_text":"وإذا النجوم انكدرت"},{"sura_number":81,"ayah_number":3,"uthmani_text":"وَإِذَا الجِبالُ سُيِّرَت","simple_text":"وإذا الجبال سيرت"},{"sura_number":81,"ayah_number":4,"uthmani_text":"وَإِذَا العِشارُ عُطِّلَت","simple_text":"وإذا العشار عطلت"},{"sura_number":81,"ayah_number":5,"uthmani_text":"وَإِذَا الوُحوشُ حُشِرَت","simple_text":"وإذا الوحوش حشرت"},{"sura_number":81,"ayah_number":6,"uthmani_text":"وَإِذَا البِحارُ سُجِّرَت","simple_text":"وإذا البحار سجرت"},{"sura_number":81,"ayah_number":7,"uthmani_text":"وَإِذَا النُّفوسُ زُوِّجَت","simple_text":"وإذا النفوس زوجت"},{"sura_number":81,"ayah_number":8,"uthmani_text":"وَإِذَا المَوءۥدَةُ سُئِلَت","simple_text":"وإذا الموءودة سئلت"},{"sura_number":81,"ayah_number":9,"uthmani_text":"بِأَىِّ ذَنبٍ قُتِلَت","simple_text":"بأي ذنب قتلت"},{"sura_number":81,"ayah_number":10,"uthmani_text":"وَإِذَا الصُّحُفُ نُشِرَت","simple_text":"وإذا الصحف نشرت"},{"sura_number":81,"ayah_number":11,"uthmani_text":"وَإِذَا السَّماءُ كُشِطَت","simple_text":"وإذا السماء كشطت"},{"sura_number":81,"ayah_number":12,"uthmani_text":"وَإِذَا الجَحيمُ سُعِّرَت","simple_text":"وإذا الجحيم سعرت"},{"sura_number":81,"ayah_number":13,"uthmani_text":"وَإِذَا الجَنَّةُ أُزلِفَت","simple_text":"وإذا الجنة أزلفت"},{"sura_number":81,"ayah_number":14,"uthmani_text":"عَلِمَت نَفسٌ ما أَحضَرَت","simple_text":"علمت نفس ما أحضرت"},{"sura_number":81,"ayah_number":15,"uthmani_text":"فَلا أُقسِمُ بِالخُنَّسِ","simple_text":"فلا أقسم بالخنس"},{"sura_number":81,"ayah_number":16,"uthmani_text":"الجَوارِ الكُنَّسِ","simple_text":"الجوار الكنس"},{"sura_number":81,"ayah_number":17,"uthmani_text":"وَالَّيلِ إِذا عَسعَسَ","simple_text":"والليل إذا عسعس"},{"sura_number":81,"ayah_number":18,"uthmani_text":"وَالصُّبحِ إِذا تَنَفَّسَ","simple_text":"والصبح إذا تنفس"},{"sura_number":81,"ayah_number":19,"uthmani_text":"إِنَّهُ لَقَولُ رَسولٍ كَريمٍ","simple_text":"إنه لقول رسول كريم"},{"sura_number":81,"ayah_number":20,"uthmani_text":"ذى قُوَّةٍ عِندَ ذِى العَرشِ مَكينٍ","simple_text":"ذي قوة عند ذي العرش مكين"},{"sura_number":81,"ayah_number":21,"uthmani_text":"مُطاعٍ ثَمَّ أَمينٍ","simple_text":"مطاع ثم أمين"},{"sura_number":81,"ayah_number":22,"uthmani_text":"وَما صاحِبُكُم بِمَجنونٍ","simple_text":"وما صاحبكم بمجنون"},{"sura_number":81,"ayah_number":23,"uthmani_text":"وَلَقَد رَءاهُ بِالأُفُقِ المُبينِ","simple_text":"ولقد رآه بالأفق المبين"},{"sura_number":81,"ayah_number":24,"uthmani_text":"وَما هُوَ عَلَى الغَيبِ بِضَنينٍ","simple_text":"وما هو على الغيب بضنين"},{"sura_number":81,"ayah_number":25,"uthmani_text":"وَما هُوَ بِقَولِ شَيطـٰنٍ رَجيمٍ","simple_text":"وما هو بقول شيطان رجيم"},{"sura_number":81,"ayah_number":26,"uthmani_text":"فَأَينَ تَذهَبونَ","simple_text":"فأين تذهبون"},{"sura_number":81,"ayah_number":27,"uthmani_text":"إِن هُوَ إِلّا ذِكرٌ لِلعـٰلَمينَ","simple_text":"إن هو إلا ذكر للعالمين"},{"sura_number":81,"ayah_number":28,"uthmani_text":"لِمَن شاءَ مِنكُم أَن يَستَقيمَ","simple_text":"لمن شاء منكم أن يستقيم"},{"sura_number":81,"ayah_number":29,"uthmani_text":"وَما تَشاءونَ إِلّا أَن يَشاءَ اللَّهُ رَبُّ العـٰلَمينَ","simple_text":"وما تشاءون إلا أن يشاء الله رب العالمين"}]