[{"sura_number":89,"ayah_number":24,"uthmani_text":"يَقولُ يـٰلَيتَنى قَدَّمتُ لِحَياتى","simple_text":"يقول يا ليتني قدمت لحياتي"},{"sura_number":89,"ayah_number":25,"uthmani_text":"فَيَومَئِذٍ لا يُعَذِّبُ عَذابَهُ أَحَدٌ","simple_text":"فيومئذ لا يعذب عذابه أحد"},{"sura_number":89,"ayah_number":26,"uthmani_text":"وَلا يوثِقُ وَثاقَهُ أَحَدٌ","simple_text":"ولا يوثق وثاقه أحد"},{"sura_number":89,"ayah_number":27,"uthmani_text":"يـٰأَيَّتُهَا النَّفسُ المُطمَئِنَّةُ","simple_text":"يا أيتها النفس المطمئنة"},{"sura_number":89,"ayah_number":28,"uthmani_text":"ارجِعى إِلىٰ رَبِّكِ راضِيَةً مَرضِيَّةً","simple_text":"ارجعي إلى ربك راضية مرضية"},{"sura_number":89,"ayah_number":29,"uthmani_text":"فَادخُلى فى عِبـٰدى","simple_text":"فادخلي في عبادي"},{"sura_number":89,"ayah_number":30,"uthmani_text":"وَادخُلى جَنَّتى","simple_text":"وادخلي جنتي"},{"sura_number":90,"ayah_number":1,"uthmani_text":"لا أُقسِمُ بِهـٰذَا البَلَدِ","simple_text":"لا أقسم بهذا البلد"},{"sura_number":90,"ayah_number":2,"uthmani_text":"وَأَنتَ حِلٌّ بِهـٰذَا البَلَدِ","simple_text":"وأنت حل بهذا البلد"},{"sura_number":90,"ayah_number":3,"uthmani_text":"وَوالِدٍ وَما وَلَدَ","simple_text":"ووالد وما ولد"},{"sura_number":90,"ayah_number":4,"uthmani_text":"لَقَد خَلَقنَا الإِنسـٰنَ فى كَبَدٍ","simple_text":"لقد خلقنا الإنسان في كبد"},{"sura_number":90,"ayah_number":5,"uthmani_text":"أَيَحسَبُ أَن لَن يَقدِرَ عَلَيهِ أَحَدٌ","simple_text":"أيحسب أن لن يقدر عليه أحد"},{"sura_number":90,"ayah_number":6,"uthmani_text":"يَقولُ أَهلَكتُ مالًا لُبَدًا","simple_text":"يقول أهلكت مالا لبدا"},{"sura_number":90,"ayah_number":7,"uthmani_text":"أَيَحسَبُ أَن لَم يَرَهُ أَحَدٌ","simple_text":"أيحسب أن لم يره أحد"},{"sura_number":90,"ayah_number":8,"uthmani_text":"أَلَم نَجعَل لَهُ عَينَينِ","simple_text":"ألم نجعل له عينين"},{"sura_number":90,"ayah_number":9,"uthmani_text":"وَلِسانًا وَشَفَتَينِ","simple_text":"ولسانا وشفتين"},{"sura_number":90,"ayah_number":10,"uthmani_text":"وَهَدَينـٰهُ النَّجدَينِ","simple_text":"وهديناه النجدين"},{"sura_number":90,"ayah_number":11,"uthmani_text":"فَلَا اقتَحَمَ العَقَبَةَ","simple_text":"فلا اقتحم العقبة"},{"sura_number":90,"ayah_number":12,"uthmani_text":"وَما أَدرىٰكَ مَا العَقَبَةُ","simple_text":"وما أدراك ما العقبة"},{"sura_number":90,"ayah_number":13,"uthmani_text":"فَكُّ رَقَبَةٍ","simple_text":"فك رقبة"},{"sura_number":90,"ayah_number":14,"uthmani_text":"أَو إِطعـٰمٌ فى يَومٍ ذى مَسغَبَةٍ","simple_text":"أو إطعام في يوم ذي مسغبة"},{"sura_number":90,"ayah_number":15,"uthmani_text":"يَتيمًا ذا مَقرَبَةٍ","simple_text":"يتيما ذا مقربة"},{"sura_number":90,"ayah_number":16,"uthmani_text":"أَو مِسكينًا ذا مَترَبَةٍ","simple_text":"أو مسكينا ذا متربة"},{"sura_number":90,"ayah_number":17,"uthmani_text":"ثُمَّ كانَ مِنَ الَّذينَ ءامَنوا وَتَواصَوا بِالصَّبرِ وَتَواصَوا بِالمَرحَمَةِ","simple_text":"ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة"},{"sura_number":90,"ayah_number":18,"uthmani_text":"أُولـٰئِكَ أَصحـٰبُ المَيمَنَةِ","simple_text":"أولئك أصحاب الميمنة"},{"sura_number":90,"ayah_number":19,"uthmani_text":"وَالَّذينَ كَفَروا بِـٔايـٰتِنا هُم أَصحـٰبُ المَشـَٔمَةِ","simple_text":"والذين كفروا بآياتنا هم أصحاب المشأمة"},{"sura_number":90,"ayah_number":20,"uthmani_text":"عَلَيهِم نارٌ مُؤصَدَةٌ","simple_text":"عليهم نار مؤصدة"}]