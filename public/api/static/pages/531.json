[{"sura_number":54,"ayah_number":50,"uthmani_text":"وَما أَمرُنا إِلّا وٰحِدَةٌ كَلَمحٍ بِالبَصَرِ","simple_text":"وما أمرنا إلا واحدة كلمح بالبصر"},{"sura_number":54,"ayah_number":51,"uthmani_text":"وَلَقَد أَهلَكنا أَشياعَكُم فَهَل مِن مُدَّكِرٍ","simple_text":"ولقد أهلكنا أشياعكم فهل من مدكر"},{"sura_number":54,"ayah_number":52,"uthmani_text":"وَكُلُّ شَىءٍ فَعَلوهُ فِى الزُّبُرِ","simple_text":"وكل شيء فعلوه في الزبر"},{"sura_number":54,"ayah_number":53,"uthmani_text":"وَكُلُّ صَغيرٍ وَكَبيرٍ مُستَطَرٌ","simple_text":"وكل صغير وكبير مستطر"},{"sura_number":54,"ayah_number":54,"uthmani_text":"إِنَّ المُتَّقينَ فى جَنّـٰتٍ وَنَهَرٍ","simple_text":"إن المتقين في جنات ونهر"},{"sura_number":54,"ayah_number":55,"uthmani_text":"فى مَقعَدِ صِدقٍ عِندَ مَليكٍ مُقتَدِرٍ","simple_text":"في مقعد صدق عند مليك مقتدر"},{"sura_number":55,"ayah_number":1,"uthmani_text":"الرَّحمـٰنُ","simple_text":"الرحمن"},{"sura_number":55,"ayah_number":2,"uthmani_text":"عَلَّمَ القُرءانَ","simple_text":"علم القرآن"},{"sura_number":55,"ayah_number":3,"uthmani_text":"خَلَقَ الإِنسـٰنَ","simple_text":"خلق الإنسان"},{"sura_number":55,"ayah_number":4,"uthmani_text":"عَلَّمَهُ البَيانَ","simple_text":"علمه البيان"},{"sura_number":55,"ayah_number":5,"uthmani_text":"الشَّمسُ وَالقَمَرُ بِحُسبانٍ","simple_text":"الشمس والقمر بحسبان"},{"sura_number":55,"ayah_number":6,"uthmani_text":"وَالنَّجمُ وَالشَّجَرُ يَسجُدانِ","simple_text":"والنجم والشجر يسجدان"},{"sura_number":55,"ayah_number":7,"uthmani_text":"وَالسَّماءَ رَفَعَها وَوَضَعَ الميزانَ","simple_text":"والسماء رفعها ووضع الميزان"},{"sura_number":55,"ayah_number":8,"uthmani_text":"أَلّا تَطغَوا فِى الميزانِ","simple_text":"ألا تطغوا في الميزان"},{"sura_number":55,"ayah_number":9,"uthmani_text":"وَأَقيمُوا الوَزنَ بِالقِسطِ وَلا تُخسِرُوا الميزانَ","simple_text":"وأقيموا الوزن بالقسط ولا تخسروا الميزان"},{"sura_number":55,"ayah_number":10,"uthmani_text":"وَالأَرضَ وَضَعَها لِلأَنامِ","simple_text":"والأرض وضعها للأنام"},{"sura_number":55,"ayah_number":11,"uthmani_text":"فيها فـٰكِهَةٌ وَالنَّخلُ ذاتُ الأَكمامِ","simple_text":"فيها فاكهة والنخل ذات الأكمام"},{"sura_number":55,"ayah_number":12,"uthmani_text":"وَالحَبُّ ذُو العَصفِ وَالرَّيحانُ","simple_text":"والحب ذو العصف والريحان"},{"sura_number":55,"ayah_number":13,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"},{"sura_number":55,"ayah_number":14,"uthmani_text":"خَلَقَ الإِنسـٰنَ مِن صَلصـٰلٍ كَالفَخّارِ","simple_text":"خلق الإنسان من صلصال كالفخار"},{"sura_number":55,"ayah_number":15,"uthmani_text":"وَخَلَقَ الجانَّ مِن مارِجٍ مِن نارٍ","simple_text":"وخلق الجان من مارج من نار"},{"sura_number":55,"ayah_number":16,"uthmani_text":"فَبِأَىِّ ءالاءِ رَبِّكُما تُكَذِّبانِ","simple_text":"فبأي آلاء ربكما تكذبان"}]