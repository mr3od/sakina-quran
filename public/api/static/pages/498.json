[{"sura_number":44,"ayah_number":40,"uthmani_text":"إِنَّ يَومَ الفَصلِ ميقـٰتُهُم أَجمَعينَ","simple_text":"إن يوم الفصل ميقاتهم أجمعين"},{"sura_number":44,"ayah_number":41,"uthmani_text":"يَومَ لا يُغنى مَولًى عَن مَولًى شَيـًٔا وَلا هُم يُنصَرونَ","simple_text":"يوم لا يغني مولى عن مولى شيئا ولا هم ينصرون"},{"sura_number":44,"ayah_number":42,"uthmani_text":"إِلّا مَن رَحِمَ اللَّهُ ۚ إِنَّهُ هُوَ العَزيزُ الرَّحيمُ","simple_text":"إلا من رحم الله ۚ إنه هو العزيز الرحيم"},{"sura_number":44,"ayah_number":43,"uthmani_text":"إِنَّ شَجَرَتَ الزَّقّومِ","simple_text":"إن شجرت الزقوم"},{"sura_number":44,"ayah_number":44,"uthmani_text":"طَعامُ الأَثيمِ","simple_text":"طعام الأثيم"},{"sura_number":44,"ayah_number":45,"uthmani_text":"كَالمُهلِ يَغلى فِى البُطونِ","simple_text":"كالمهل يغلي في البطون"},{"sura_number":44,"ayah_number":46,"uthmani_text":"كَغَلىِ الحَميمِ","simple_text":"كغلي الحميم"},{"sura_number":44,"ayah_number":47,"uthmani_text":"خُذوهُ فَاعتِلوهُ إِلىٰ سَواءِ الجَحيمِ","simple_text":"خذوه فاعتلوه إلى سواء الجحيم"},{"sura_number":44,"ayah_number":48,"uthmani_text":"ثُمَّ صُبّوا فَوقَ رَأسِهِ مِن عَذابِ الحَميمِ","simple_text":"ثم صبوا فوق رأسه من عذاب الحميم"},{"sura_number":44,"ayah_number":49,"uthmani_text":"ذُق إِنَّكَ أَنتَ العَزيزُ الكَريمُ","simple_text":"ذق إنك أنت العزيز الكريم"},{"sura_number":44,"ayah_number":50,"uthmani_text":"إِنَّ هـٰذا ما كُنتُم بِهِ تَمتَرونَ","simple_text":"إن هذا ما كنتم به تمترون"},{"sura_number":44,"ayah_number":51,"uthmani_text":"إِنَّ المُتَّقينَ فى مَقامٍ أَمينٍ","simple_text":"إن المتقين في مقام أمين"},{"sura_number":44,"ayah_number":52,"uthmani_text":"فى جَنّـٰتٍ وَعُيونٍ","simple_text":"في جنات وعيون"},{"sura_number":44,"ayah_number":53,"uthmani_text":"يَلبَسونَ مِن سُندُسٍ وَإِستَبرَقٍ مُتَقـٰبِلينَ","simple_text":"يلبسون من سندس وإستبرق متقابلين"},{"sura_number":44,"ayah_number":54,"uthmani_text":"كَذٰلِكَ وَزَوَّجنـٰهُم بِحورٍ عينٍ","simple_text":"كذلك وزوجناهم بحور عين"},{"sura_number":44,"ayah_number":55,"uthmani_text":"يَدعونَ فيها بِكُلِّ فـٰكِهَةٍ ءامِنينَ","simple_text":"يدعون فيها بكل فاكهة آمنين"},{"sura_number":44,"ayah_number":56,"uthmani_text":"لا يَذوقونَ فيهَا المَوتَ إِلَّا المَوتَةَ الأولىٰ ۖ وَوَقىٰهُم عَذابَ الجَحيمِ","simple_text":"لا يذوقون فيها الموت إلا الموتة الأولى ۖ ووقاهم عذاب الجحيم"},{"sura_number":44,"ayah_number":57,"uthmani_text":"فَضلًا مِن رَبِّكَ ۚ ذٰلِكَ هُوَ الفَوزُ العَظيمُ","simple_text":"فضلا من ربك ۚ ذلك هو الفوز العظيم"},{"sura_number":44,"ayah_number":58,"uthmani_text":"فَإِنَّما يَسَّرنـٰهُ بِلِسانِكَ لَعَلَّهُم يَتَذَكَّرونَ","simple_text":"فإنما يسرناه بلسانك لعلهم يتذكرون"},{"sura_number":44,"ayah_number":59,"uthmani_text":"فَارتَقِب إِنَّهُم مُرتَقِبونَ","simple_text":"فارتقب إنهم مرتقبون"}]