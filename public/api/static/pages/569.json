[{"sura_number":70,"ayah_number":11,"uthmani_text":"يُبَصَّرونَهُم ۚ يَوَدُّ المُجرِمُ لَو يَفتَدى مِن عَذابِ يَومِئِذٍ بِبَنيهِ","simple_text":"يبصرونهم ۚ يود المجرم لو يفتدي من عذاب يومئذ ببنيه"},{"sura_number":70,"ayah_number":12,"uthmani_text":"وَصـٰحِبَتِهِ وَأَخيهِ","simple_text":"وصاحبته وأخيه"},{"sura_number":70,"ayah_number":13,"uthmani_text":"وَفَصيلَتِهِ الَّتى تُـٔويهِ","simple_text":"وفصيلته التي تؤويه"},{"sura_number":70,"ayah_number":14,"uthmani_text":"وَمَن فِى الأَرضِ جَميعًا ثُمَّ يُنجيهِ","simple_text":"ومن في الأرض جميعا ثم ينجيه"},{"sura_number":70,"ayah_number":15,"uthmani_text":"كَلّا ۖ إِنَّها لَظىٰ","simple_text":"كلا ۖ إنها لظى"},{"sura_number":70,"ayah_number":16,"uthmani_text":"نَزّاعَةً لِلشَّوىٰ","simple_text":"نزاعة للشوى"},{"sura_number":70,"ayah_number":17,"uthmani_text":"تَدعوا مَن أَدبَرَ وَتَوَلّىٰ","simple_text":"تدعو من أدبر وتولى"},{"sura_number":70,"ayah_number":18,"uthmani_text":"وَجَمَعَ فَأَوعىٰ","simple_text":"وجمع فأوعى"},{"sura_number":70,"ayah_number":19,"uthmani_text":"۞ إِنَّ الإِنسـٰنَ خُلِقَ هَلوعًا","simple_text":"۞ إن الإنسان خلق هلوعا"},{"sura_number":70,"ayah_number":20,"uthmani_text":"إِذا مَسَّهُ الشَّرُّ جَزوعًا","simple_text":"إذا مسه الشر جزوعا"},{"sura_number":70,"ayah_number":21,"uthmani_text":"وَإِذا مَسَّهُ الخَيرُ مَنوعًا","simple_text":"وإذا مسه الخير منوعا"},{"sura_number":70,"ayah_number":22,"uthmani_text":"إِلَّا المُصَلّينَ","simple_text":"إلا المصلين"},{"sura_number":70,"ayah_number":23,"uthmani_text":"الَّذينَ هُم عَلىٰ صَلاتِهِم دائِمونَ","simple_text":"الذين هم على صلاتهم دائمون"},{"sura_number":70,"ayah_number":24,"uthmani_text":"وَالَّذينَ فى أَموٰلِهِم حَقٌّ مَعلومٌ","simple_text":"والذين في أموالهم حق معلوم"},{"sura_number":70,"ayah_number":25,"uthmani_text":"لِلسّائِلِ وَالمَحرومِ","simple_text":"للسائل والمحروم"},{"sura_number":70,"ayah_number":26,"uthmani_text":"وَالَّذينَ يُصَدِّقونَ بِيَومِ الدّينِ","simple_text":"والذين يصدقون بيوم الدين"},{"sura_number":70,"ayah_number":27,"uthmani_text":"وَالَّذينَ هُم مِن عَذابِ رَبِّهِم مُشفِقونَ","simple_text":"والذين هم من عذاب ربهم مشفقون"},{"sura_number":70,"ayah_number":28,"uthmani_text":"إِنَّ عَذابَ رَبِّهِم غَيرُ مَأمونٍ","simple_text":"إن عذاب ربهم غير مأمون"},{"sura_number":70,"ayah_number":29,"uthmani_text":"وَالَّذينَ هُم لِفُروجِهِم حـٰفِظونَ","simple_text":"والذين هم لفروجهم حافظون"},{"sura_number":70,"ayah_number":30,"uthmani_text":"إِلّا عَلىٰ أَزوٰجِهِم أَو ما مَلَكَت أَيمـٰنُهُم فَإِنَّهُم غَيرُ مَلومينَ","simple_text":"إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين"},{"sura_number":70,"ayah_number":31,"uthmani_text":"فَمَنِ ابتَغىٰ وَراءَ ذٰلِكَ فَأُولـٰئِكَ هُمُ العادونَ","simple_text":"فمن ابتغى وراء ذلك فأولئك هم العادون"},{"sura_number":70,"ayah_number":32,"uthmani_text":"وَالَّذينَ هُم لِأَمـٰنـٰتِهِم وَعَهدِهِم رٰعونَ","simple_text":"والذين هم لأماناتهم وعهدهم راعون"},{"sura_number":70,"ayah_number":33,"uthmani_text":"وَالَّذينَ هُم بِشَهـٰدٰتِهِم قائِمونَ","simple_text":"والذين هم بشهاداتهم قائمون"},{"sura_number":70,"ayah_number":34,"uthmani_text":"وَالَّذينَ هُم عَلىٰ صَلاتِهِم يُحافِظونَ","simple_text":"والذين هم على صلاتهم يحافظون"},{"sura_number":70,"ayah_number":35,"uthmani_text":"أُولـٰئِكَ فى جَنّـٰتٍ مُكرَمونَ","simple_text":"أولئك في جنات مكرمون"},{"sura_number":70,"ayah_number":36,"uthmani_text":"فَمالِ الَّذينَ كَفَروا قِبَلَكَ مُهطِعينَ","simple_text":"فمال الذين كفروا قبلك مهطعين"},{"sura_number":70,"ayah_number":37,"uthmani_text":"عَنِ اليَمينِ وَعَنِ الشِّمالِ عِزينَ","simple_text":"عن اليمين وعن الشمال عزين"},{"sura_number":70,"ayah_number":38,"uthmani_text":"أَيَطمَعُ كُلُّ امرِئٍ مِنهُم أَن يُدخَلَ جَنَّةَ نَعيمٍ","simple_text":"أيطمع كل امرئ منهم أن يدخل جنة نعيم"},{"sura_number":70,"ayah_number":39,"uthmani_text":"كَلّا ۖ إِنّا خَلَقنـٰهُم مِمّا يَعلَمونَ","simple_text":"كلا ۖ إنا خلقناهم مما يعلمون"}]