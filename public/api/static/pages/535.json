[{"sura_number":56,"ayah_number":17,"uthmani_text":"يَطوفُ عَلَيهِم وِلدٰنٌ مُخَلَّدونَ","simple_text":"يطوف عليهم ولدان مخلدون"},{"sura_number":56,"ayah_number":18,"uthmani_text":"بِأَكوابٍ وَأَباريقَ وَكَأسٍ مِن مَعينٍ","simple_text":"بأكواب وأباريق وكأس من معين"},{"sura_number":56,"ayah_number":19,"uthmani_text":"لا يُصَدَّعونَ عَنها وَلا يُنزِفونَ","simple_text":"لا يصدعون عنها ولا ينزفون"},{"sura_number":56,"ayah_number":20,"uthmani_text":"وَفـٰكِهَةٍ مِمّا يَتَخَيَّرونَ","simple_text":"وفاكهة مما يتخيرون"},{"sura_number":56,"ayah_number":21,"uthmani_text":"وَلَحمِ طَيرٍ مِمّا يَشتَهونَ","simple_text":"ولحم طير مما يشتهون"},{"sura_number":56,"ayah_number":22,"uthmani_text":"وَحورٌ عينٌ","simple_text":"وحور عين"},{"sura_number":56,"ayah_number":23,"uthmani_text":"كَأَمثـٰلِ اللُّؤلُؤِ المَكنونِ","simple_text":"كأمثال اللؤلؤ المكنون"},{"sura_number":56,"ayah_number":24,"uthmani_text":"جَزاءً بِما كانوا يَعمَلونَ","simple_text":"جزاء بما كانوا يعملون"},{"sura_number":56,"ayah_number":25,"uthmani_text":"لا يَسمَعونَ فيها لَغوًا وَلا تَأثيمًا","simple_text":"لا يسمعون فيها لغوا ولا تأثيما"},{"sura_number":56,"ayah_number":26,"uthmani_text":"إِلّا قيلًا سَلـٰمًا سَلـٰمًا","simple_text":"إلا قيلا سلاما سلاما"},{"sura_number":56,"ayah_number":27,"uthmani_text":"وَأَصحـٰبُ اليَمينِ ما أَصحـٰبُ اليَمينِ","simple_text":"وأصحاب اليمين ما أصحاب اليمين"},{"sura_number":56,"ayah_number":28,"uthmani_text":"فى سِدرٍ مَخضودٍ","simple_text":"في سدر مخضود"},{"sura_number":56,"ayah_number":29,"uthmani_text":"وَطَلحٍ مَنضودٍ","simple_text":"وطلح منضود"},{"sura_number":56,"ayah_number":30,"uthmani_text":"وَظِلٍّ مَمدودٍ","simple_text":"وظل ممدود"},{"sura_number":56,"ayah_number":31,"uthmani_text":"وَماءٍ مَسكوبٍ","simple_text":"وماء مسكوب"},{"sura_number":56,"ayah_number":32,"uthmani_text":"وَفـٰكِهَةٍ كَثيرَةٍ","simple_text":"وفاكهة كثيرة"},{"sura_number":56,"ayah_number":33,"uthmani_text":"لا مَقطوعَةٍ وَلا مَمنوعَةٍ","simple_text":"لا مقطوعة ولا ممنوعة"},{"sura_number":56,"ayah_number":34,"uthmani_text":"وَفُرُشٍ مَرفوعَةٍ","simple_text":"وفرش مرفوعة"},{"sura_number":56,"ayah_number":35,"uthmani_text":"إِنّا أَنشَأنـٰهُنَّ إِنشاءً","simple_text":"إنا أنشأناهن إنشاء"},{"sura_number":56,"ayah_number":36,"uthmani_text":"فَجَعَلنـٰهُنَّ أَبكارًا","simple_text":"فجعلناهن أبكارا"},{"sura_number":56,"ayah_number":37,"uthmani_text":"عُرُبًا أَترابًا","simple_text":"عربا أترابا"},{"sura_number":56,"ayah_number":38,"uthmani_text":"لِأَصحـٰبِ اليَمينِ","simple_text":"لأصحاب اليمين"},{"sura_number":56,"ayah_number":39,"uthmani_text":"ثُلَّةٌ مِنَ الأَوَّلينَ","simple_text":"ثلة من الأولين"},{"sura_number":56,"ayah_number":40,"uthmani_text":"وَثُلَّةٌ مِنَ الـٔاخِرينَ","simple_text":"وثلة من الآخرين"},{"sura_number":56,"ayah_number":41,"uthmani_text":"وَأَصحـٰبُ الشِّمالِ ما أَصحـٰبُ الشِّمالِ","simple_text":"وأصحاب الشمال ما أصحاب الشمال"},{"sura_number":56,"ayah_number":42,"uthmani_text":"فى سَمومٍ وَحَميمٍ","simple_text":"في سموم وحميم"},{"sura_number":56,"ayah_number":43,"uthmani_text":"وَظِلٍّ مِن يَحمومٍ","simple_text":"وظل من يحموم"},{"sura_number":56,"ayah_number":44,"uthmani_text":"لا بارِدٍ وَلا كَريمٍ","simple_text":"لا بارد ولا كريم"},{"sura_number":56,"ayah_number":45,"uthmani_text":"إِنَّهُم كانوا قَبلَ ذٰلِكَ مُترَفينَ","simple_text":"إنهم كانوا قبل ذلك مترفين"},{"sura_number":56,"ayah_number":46,"uthmani_text":"وَكانوا يُصِرّونَ عَلَى الحِنثِ العَظيمِ","simple_text":"وكانوا يصرون على الحنث العظيم"},{"sura_number":56,"ayah_number":47,"uthmani_text":"وَكانوا يَقولونَ أَئِذا مِتنا وَكُنّا تُرابًا وَعِظـٰمًا أَءِنّا لَمَبعوثونَ","simple_text":"وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أإنا لمبعوثون"},{"sura_number":56,"ayah_number":48,"uthmani_text":"أَوَءاباؤُنَا الأَوَّلونَ","simple_text":"أوآباؤنا الأولون"},{"sura_number":56,"ayah_number":49,"uthmani_text":"قُل إِنَّ الأَوَّلينَ وَالـٔاخِرينَ","simple_text":"قل إن الأولين والآخرين"},{"sura_number":56,"ayah_number":50,"uthmani_text":"لَمَجموعونَ إِلىٰ ميقـٰتِ يَومٍ مَعلومٍ","simple_text":"لمجموعون إلى ميقات يوم معلوم"}]