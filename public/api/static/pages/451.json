[{"sura_number":37,"ayah_number":127,"uthmani_text":"فَكَذَّبوهُ فَإِنَّهُم لَمُحضَرونَ","simple_text":"فكذبوه فإنهم لمحضرون"},{"sura_number":37,"ayah_number":128,"uthmani_text":"إِلّا عِبادَ اللَّهِ المُخلَصينَ","simple_text":"إلا عباد الله المخلصين"},{"sura_number":37,"ayah_number":129,"uthmani_text":"وَتَرَكنا عَلَيهِ فِى الـٔاخِرينَ","simple_text":"وتركنا عليه في الآخرين"},{"sura_number":37,"ayah_number":130,"uthmani_text":"سَلـٰمٌ عَلىٰ إِل ياسينَ","simple_text":"سلام على إل ياسين"},{"sura_number":37,"ayah_number":131,"uthmani_text":"إِنّا كَذٰلِكَ نَجزِى المُحسِنينَ","simple_text":"إنا كذلك نجزي المحسنين"},{"sura_number":37,"ayah_number":132,"uthmani_text":"إِنَّهُ مِن عِبادِنَا المُؤمِنينَ","simple_text":"إنه من عبادنا المؤمنين"},{"sura_number":37,"ayah_number":133,"uthmani_text":"وَإِنَّ لوطًا لَمِنَ المُرسَلينَ","simple_text":"وإن لوطا لمن المرسلين"},{"sura_number":37,"ayah_number":134,"uthmani_text":"إِذ نَجَّينـٰهُ وَأَهلَهُ أَجمَعينَ","simple_text":"إذ نجيناه وأهله أجمعين"},{"sura_number":37,"ayah_number":135,"uthmani_text":"إِلّا عَجوزًا فِى الغـٰبِرينَ","simple_text":"إلا عجوزا في الغابرين"},{"sura_number":37,"ayah_number":136,"uthmani_text":"ثُمَّ دَمَّرنَا الـٔاخَرينَ","simple_text":"ثم دمرنا الآخرين"},{"sura_number":37,"ayah_number":137,"uthmani_text":"وَإِنَّكُم لَتَمُرّونَ عَلَيهِم مُصبِحينَ","simple_text":"وإنكم لتمرون عليهم مصبحين"},{"sura_number":37,"ayah_number":138,"uthmani_text":"وَبِالَّيلِ ۗ أَفَلا تَعقِلونَ","simple_text":"وبالليل ۗ أفلا تعقلون"},{"sura_number":37,"ayah_number":139,"uthmani_text":"وَإِنَّ يونُسَ لَمِنَ المُرسَلينَ","simple_text":"وإن يونس لمن المرسلين"},{"sura_number":37,"ayah_number":140,"uthmani_text":"إِذ أَبَقَ إِلَى الفُلكِ المَشحونِ","simple_text":"إذ أبق إلى الفلك المشحون"},{"sura_number":37,"ayah_number":141,"uthmani_text":"فَساهَمَ فَكانَ مِنَ المُدحَضينَ","simple_text":"فساهم فكان من المدحضين"},{"sura_number":37,"ayah_number":142,"uthmani_text":"فَالتَقَمَهُ الحوتُ وَهُوَ مُليمٌ","simple_text":"فالتقمه الحوت وهو مليم"},{"sura_number":37,"ayah_number":143,"uthmani_text":"فَلَولا أَنَّهُ كانَ مِنَ المُسَبِّحينَ","simple_text":"فلولا أنه كان من المسبحين"},{"sura_number":37,"ayah_number":144,"uthmani_text":"لَلَبِثَ فى بَطنِهِ إِلىٰ يَومِ يُبعَثونَ","simple_text":"للبث في بطنه إلى يوم يبعثون"},{"sura_number":37,"ayah_number":145,"uthmani_text":"۞ فَنَبَذنـٰهُ بِالعَراءِ وَهُوَ سَقيمٌ","simple_text":"۞ فنبذناه بالعراء وهو سقيم"},{"sura_number":37,"ayah_number":146,"uthmani_text":"وَأَنبَتنا عَلَيهِ شَجَرَةً مِن يَقطينٍ","simple_text":"وأنبتنا عليه شجرة من يقطين"},{"sura_number":37,"ayah_number":147,"uthmani_text":"وَأَرسَلنـٰهُ إِلىٰ مِا۟ئَةِ أَلفٍ أَو يَزيدونَ","simple_text":"وأرسلناه إلى مائة ألف أو يزيدون"},{"sura_number":37,"ayah_number":148,"uthmani_text":"فَـٔامَنوا فَمَتَّعنـٰهُم إِلىٰ حينٍ","simple_text":"فآمنوا فمتعناهم إلى حين"},{"sura_number":37,"ayah_number":149,"uthmani_text":"فَاستَفتِهِم أَلِرَبِّكَ البَناتُ وَلَهُمُ البَنونَ","simple_text":"فاستفتهم ألربك البنات ولهم البنون"},{"sura_number":37,"ayah_number":150,"uthmani_text":"أَم خَلَقنَا المَلـٰئِكَةَ إِنـٰثًا وَهُم شـٰهِدونَ","simple_text":"أم خلقنا الملائكة إناثا وهم شاهدون"},{"sura_number":37,"ayah_number":151,"uthmani_text":"أَلا إِنَّهُم مِن إِفكِهِم لَيَقولونَ","simple_text":"ألا إنهم من إفكهم ليقولون"},{"sura_number":37,"ayah_number":152,"uthmani_text":"وَلَدَ اللَّهُ وَإِنَّهُم لَكـٰذِبونَ","simple_text":"ولد الله وإنهم لكاذبون"},{"sura_number":37,"ayah_number":153,"uthmani_text":"أَصطَفَى البَناتِ عَلَى البَنينَ","simple_text":"أصطفى البنات على البنين"}]