{
  "expo": {
    "name": "sakina-quran",
    "slug": "sakina-quran",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "sakina-quran",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#fdfbf7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mr3od.sakinaquran",
      "appleTeamId": "23P4PL927X",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      }
    },
    "android": {
      "package": "dev.mr3od.sakinaquran",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": "./languages/english.json",
      "ar": "./languages/arabic.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://quran.mr3od.dev"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fdfbf7",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#1e1b17"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/UthmanicHafs_V22.ttf",
            "./assets/fonts/SurahNames_V4.ttf",
            "./assets/fonts/JuzNames_V2.ttf",
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/NotoSansArabic_400Regular.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "react-native-localize",
        {
          "locales": [
            "en",
            "ar"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://quran.mr3od.dev"
      },
      "eas": {
        "projectId": "bb8030e4-12fe-49c8-8f6a-98689debb569"
      }
    },
    "owner": "abdulrahman-ye"
  }
}
