    "@tanstack/react-query": "^5.102.3",
    "expo": "57.0.16",
    "expo-build-properties": "~57.0.14",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
