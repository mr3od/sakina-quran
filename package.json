    "babel-preset-expo": "^57.0.8",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "expo-dev-client": "~57.0.15",
    "jest": "~29.7.0",
